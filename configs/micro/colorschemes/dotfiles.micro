color-link default "#ffffff,#222226"
color-link comment "italic #aaaaaa,#222226"
color-link constant "#ffbe6f,#222226"
color-link identifier "#ffffff,#222226"
color-link statement "bold #ffa348,#222226"
color-link symbol "#ffffff,#222226"
color-link preproc "#ffbe6f,#222226"
color-link type "bold #ffbe6f,#222226"
color-link special "#ffa348,#222226"
color-link underlined "underline #ffbe6f,#222226"
color-link error "bold #222226,#ffa348"
color-link todo "bold #222226,#ffbe6f"
color-link selection "#222226,#ffbe6f"
color-link statusline "#ffffff,#38383c"
color-link statusline.inactive "#aaaaaa,#38383c"
color-link statusline.suggestions "#ffffff,#38383c"
color-link tabbar "#aaaaaa,#38383c"
color-link tabbar.active "bold #222226,#ffbe6f"
color-link indent-char "#38383c,#222226"
color-link line-number "#aaaaaa,#222226"
color-link current-line-number "bold #ffbe6f,#38383c"
color-link gutter-info "#ffbe6f,#222226"
color-link gutter-error "#ffa348,#222226"
color-link gutter-warning "#ffbe6f,#222226"
color-link diff-added "#ffbe6f,#222226"
color-link diff-modified "#ffa348,#222226"
color-link diff-deleted "#aaaaaa,#222226"
color-link cursor-line "#ffffff,#38383c"
color-link color-column "#ffffff,#38383c"
color-link ignore "#aaaaaa,#222226"
color-link scrollbar "#ffbe6f,#38383c"
color-link divider "#aaaaaa,#38383c"
color-link message "#ffbe6f,#222226"
color-link error-message "bold #222226,#ffa348"
color-link match-brace "bold #222226,#ffbe6f"
color-link hlsearch "#222226,#ffa348"
color-link tab-error "#222226,#ffa348"
color-link trailingws "#222226,#ffa348"
