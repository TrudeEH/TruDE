{
    "mode": "dock",
    "position": "top",
    "layer": "top",
    "width": 0,
    "height": 0,
    "margin": 0,
    "spacing": 0,
    "fixed-center": true,
    "reload_style_on_change": true,

    "modules-left": [
        "tray",
        "custom/left#bg-1",
        "hyprland/workspaces",
        "custom/right#bg-1"
    ],
    "modules-center": [
        "group/center-left",
        "group/app-launcher",
        "group/center-right"
    ],
    "modules-right": [
        "custom/left#bg-1",
        "pulseaudio",

        "custom/left#bg-2",
        "custom/maintenance",

        "custom/left#bg-3",
        "custom/power-profile",
        "custom/left#inverse",

        "custom/power-menu"
    ],

    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "visible": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        },
        "sort-by": "number"
    },
    "custom/temperature": {
        "exec": "dotfiles-waybar-temperature-status",
        "return-type": "json",
        "interval": 5,
        "min-length": 8,
        "max-length": 8,
        "on-click": "footclient --app-id=temperature-tui --title='Temperature Monitor' --override=colors.regular0=222226 --window-size-chars=104x32 dotfiles-temperature-tui"
    },
    "memory": {
        "format": "󰘚 {percentage}%",
        "format-warning": "󰀧 {percentage}%",
        "format-critical": "󰀧 {percentage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "interval": 2,
        "min-length": 8,
        "max-length": 8,
        "tooltip-format": "Memory: {percentage}%",
        "on-click": "footclient --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "format-warning": "󰀨 {usage}%",
        "format-critical": "󰀨 {usage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "interval": 2,
        "min-length": 8,
        "max-length": 8,
        "tooltip-format": "CPU: {usage}%",
        "on-click": "footclient --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "custom/launcher": {
        "exec": "dotfiles-waybar-launcher-status center",
        "return-type": "json",
        "interval": 1,
        "min-length": 2,
        "max-length": 2,
        "align": 0.5,
        "justify": "center",
        "tooltip": false,
        "on-click": "dotfiles-app-launcher-toggle"
    },
    "group/center-left": {
        "orientation": "horizontal",
        "modules": [
            "custom/left#bg-1",
            "custom/temperature",
            "custom/left#bg-2",
            "memory",
            "custom/left#bg-3",
            "cpu",
            "custom/left#inverse"
        ]
    },
    "group/app-launcher": {
        "orientation": "horizontal",
        "modules": [
            "custom/left#accent",
            "custom/launcher",
            "custom/right#accent"
        ]
    },
    "group/center-right": {
        "orientation": "horizontal",
        "modules": [
            "custom/right#inverse",
            "clock#time",
            "custom/right#bg-3",
            "clock#date",
            "custom/right#bg-2",
            "custom/status-indicators",
            "custom/right#bg-1"
        ]
    },
    "clock#time": {
        "format": "{:%I:%M %p}",
        "min-length": 8,
        "max-length": 8,
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "footclient --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui"
    },
    "clock#date": {
        "format": "󰸗 {:%a %d %b}",
        "min-length": 8,
        "max-length": 8,
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "footclient --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui"
    },
    "custom/status-indicators": {
        "exec": "dotfiles-waybar-status-indicators",
        "return-type": "json",
        "interval": 2,
        "min-length": 8,
        "max-length": 8,
        "align": 0.5,
        "justify": "center",
        "on-click": "footclient --app-id=status-menu --title='Quick Settings' --override=colors.regular0=222226 --window-size-chars=42x10 dotfiles-waybar-status-menu",
        "on-click-right": "makoctl mode -t do-not-disturb"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "min-length": 8,
        "scroll-step": 5,
        "on-click": "footclient --app-id=pulsemixer --title='Volume Mixer' --window-size-chars=94x28 pulsemixer"
    },
    "custom/maintenance": {
        "exec": "dotfiles-waybar-maintenance-status",
        "return-type": "json",
        "interval": 300,
        "signal": 8,
        "min-length": 8,
        "on-click": "footclient --app-id=maintenance-tui --title='Debian Maintenance' --override=colors.regular0=222226 --window-size-chars=104x32 dotfiles-maintenance-tui"
    },
    "custom/power-profile": {
        "exec": "dotfiles-waybar-power-status",
        "return-type": "json",
        "interval": 5,
        "align": 0.5,
        "min-length": 8,
        "on-click": "footclient --app-id=power-profiles-tui --title='Power Profile' --override=colors.regular0=222226 --window-size-chars=82x24 dotfiles-power-profiles-tui"
    },
    "custom/power-menu": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "footclient --app-id=power-menu-tui --title='Power' --override=colors.regular0=222226 --window-size-chars=88x23 dotfiles-power-menu-tui"
    },

    "custom/left#accent": {
        "exec": "dotfiles-waybar-launcher-status left",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },
    "custom/left#bg-1": {
        "format": "",
        "tooltip": false
    },
    "custom/left#bg-2": {
        "format": "",
        "tooltip": false
    },
    "custom/left#bg-3": {
        "format": "",
        "tooltip": false
    },
    "custom/left#inverse": {
        "format": "",
        "tooltip": false
    },
    "custom/right#accent": {
        "exec": "dotfiles-waybar-launcher-status right",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },
    "custom/right#bg-1": {
        "format": "",
        "tooltip": false
    },
    "custom/right#bg-2": {
        "format": "",
        "tooltip": false
    },
    "custom/right#bg-3": {
        "format": "",
        "tooltip": false
    },
    "custom/right#inverse": {
        "format": "",
        "tooltip": false
    }
}
