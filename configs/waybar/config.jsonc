{
    "mode": "dock",
    "position": "top",
    "layer": "top",
    "width": 0,
    "height": 0,
    "margin": 0,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "tray",
        "custom/left#bg-1",
        "hyprland/workspaces",
        "custom/right#bg-1"
    ],
    "modules-center": [
        "custom/left#bg-1",
        "custom/temperature",

        "custom/left#bg-2",
        "memory",

        "custom/left#bg-3",
        "cpu",
        "custom/left#inverse",

        "group/app-launcher",

        "custom/right#inverse",
        "clock#time",
        "custom/right#bg-3",

        "clock#date",
        "custom/right#bg-2",

        "network",
        "bluetooth",
        "custom/notification",
        "custom/right#bg-1"
    ],
    "modules-right": [
        "custom/left#bg-1",
        "pulseaudio",

        "custom/left#bg-2",
        "custom/maintenance",

        "custom/left#bg-3",
        "custom/power-profile",
        "custom/left#inverse",

        "custom/power-menu"
    ],

    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "visible": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        },
        "sort-by": "number"
    },
    "custom/temperature": {
        "exec": "dotfiles-waybar-temperature-status",
        "return-type": "json",
        "interval": 5,
        "min-length": 8,
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "memory": {
        "format": "󰘚 {percentage}%",
        "format-warning": "󰀧 {percentage}%",
        "format-critical": "󰀧 {percentage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "interval": 2,
        "min-length": 8,
        "tooltip-format": "Memory: {percentage}%",
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "format-warning": "󰀨 {usage}%",
        "format-critical": "󰀨 {usage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "interval": 2,
        "min-length": 8,
        "tooltip-format": "CPU: {usage}%",
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "custom/launcher": {
        "exec": "dotfiles-waybar-launcher-status center",
        "return-type": "json",
        "interval": 1,
        "tooltip": false,
        "on-click": "dotfiles-app-launcher-toggle"
    },
    "group/app-launcher": {
        "orientation": "horizontal",
        "modules": [
            "custom/left#accent",
            "custom/launcher",
            "custom/right#accent"
        ]
    },
    "clock#time": {
        "format": "{:%I:%M %p}",
        "min-length": 8,
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui"
    },
    "clock#date": {
        "format": "󰸗 {:%a %d %b}",
        "min-length": 13,
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui"
    },
    "network": {
        "interval": 2,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤭",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "Ethernet\n{ipaddr}",
        "tooltip-format-disconnected": "Offline",
        "on-click": "foot --app-id=nmtui --title='Network Settings' --override=colors.regular0=222226 --window-size-chars=82x24 dotfiles-network-tui"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "foot --app-id=bluetooth-tui --title='Bluetooth' --override=colors.regular0=222226 --window-size-chars=82x26 dotfiles-bluetooth-tui"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon} {text}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂚",
            "dnd-notification": "󱏨",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󱏨",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec": "dotfiles-waybar-notification-status",
        "interval": 5,
        "hide-empty-text": true,
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui",
        "on-click-right": "makoctl mode -t do-not-disturb"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "min-length": 8,
        "scroll-step": 5,
        "on-click": "foot --app-id=pulsemixer --title='Volume Mixer' --window-size-chars=94x28 pulsemixer"
    },
    "custom/maintenance": {
        "exec": "dotfiles-waybar-maintenance-status",
        "return-type": "json",
        "interval": 300,
        "signal": 8,
        "min-length": 5,
        "on-click": "foot --app-id=maintenance-tui --title='Debian Maintenance' --override=colors.regular0=222226 --window-size-chars=104x32 dotfiles-maintenance-tui"
    },
    "custom/power-profile": {
        "exec": "dotfiles-waybar-power-status",
        "return-type": "json",
        "interval": 5,
        "min-length": 5,
        "on-click": "foot --app-id=power-profiles-tui --title='Power Profile' --override=colors.regular0=222226 --window-size-chars=82x24 dotfiles-power-profiles-tui"
    },
    "custom/power-menu": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "foot --app-id=power-menu-tui --title='Power' --override=colors.regular0=222226 --window-size-chars=88x23 dotfiles-power-menu-tui"
    },

    "custom/left#accent": {
        "exec": "dotfiles-waybar-launcher-status left",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },
    "custom/left#bg-1": {
        "format": "",
        "tooltip": false
    },
    "custom/left#bg-2": {
        "format": "",
        "tooltip": false
    },
    "custom/left#bg-3": {
        "format": "",
        "tooltip": false
    },
    "custom/left#inverse": {
        "format": "",
        "tooltip": false
    },
    "custom/right#accent": {
        "exec": "dotfiles-waybar-launcher-status right",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },
    "custom/right#bg-1": {
        "format": "",
        "tooltip": false
    },
    "custom/right#bg-2": {
        "format": "",
        "tooltip": false
    },
    "custom/right#bg-3": {
        "format": "",
        "tooltip": false
    },
    "custom/right#inverse": {
        "format": "",
        "tooltip": false
    }
}
