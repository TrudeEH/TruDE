{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "modules-left": [
        "custom/launcher",
        "custom/workspace-1",
        "custom/workspace-2",
        "custom/workspace-3",
        "custom/workspace-4",
        "custom/workspace-5",
        "custom/workspace-6",
        "custom/workspace-7",
        "custom/workspace-8",
        "custom/workspace-9",
        "custom/workspace-10"
    ],
    "modules-center": [
        "clock",
        "custom/notification"
    ],
    "modules-right": [
        "group/system-status",
        "network",
        "bluetooth",
        "custom/power-profile",
        "custom/maintenance",
        "pulseaudio",
        "tray",
        "privacy",
        "custom/power-menu"
    ],

    "custom/launcher": {
        "format": "󰀻",
        "tooltip": false,
        "on-click": "dotfiles-app-launcher-toggle"
    },
    "custom/workspace-1": {
        "exec": "dotfiles-waybar-workspace status 1",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 1"
    },
    "custom/workspace-2": {
        "exec": "dotfiles-waybar-workspace status 2",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 2"
    },
    "custom/workspace-3": {
        "exec": "dotfiles-waybar-workspace status 3",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 3"
    },
    "custom/workspace-4": {
        "exec": "dotfiles-waybar-workspace status 4",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 4"
    },
    "custom/workspace-5": {
        "exec": "dotfiles-waybar-workspace status 5",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 5"
    },
    "custom/workspace-6": {
        "exec": "dotfiles-waybar-workspace status 6",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 6"
    },
    "custom/workspace-7": {
        "exec": "dotfiles-waybar-workspace status 7",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 7"
    },
    "custom/workspace-8": {
        "exec": "dotfiles-waybar-workspace status 8",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 8"
    },
    "custom/workspace-9": {
        "exec": "dotfiles-waybar-workspace status 9",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 9"
    },
    "custom/workspace-10": {
        "exec": "dotfiles-waybar-workspace status 10",
        "return-type": "json",
        "interval": "once",
        "signal": 7,
        "on-click": "dotfiles-waybar-workspace focus 10"
    },
    "clock": {
        "format": "{:%a %d %b  %I:%M %p}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon} {text}",
        "format-icons": {
            "notification": "󰂚",
            "none": "",
            "dnd-notification": "󱏨",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "",
            "dnd-inhibited-notification": "󱏨",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec": "dotfiles-waybar-notification-status",
        "interval": 5,
        "hide-empty-text": true,
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui",
        "on-click-right": "makoctl mode -t do-not-disturb"
    },
    "group/system-status": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "custom/temperature"]
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "tooltip-format": "CPU: {usage}%",
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 2,
        "tooltip-format": "Memory: {percentage}%",
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "custom/temperature": {
        "exec": "dotfiles-waybar-temperature-status",
        "return-type": "json",
        "interval": 5,
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "foot --app-id=pulsemixer --title='Volume Mixer' --window-size-chars=94x28 pulsemixer"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱  {num_connections}",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "foot --app-id=bluetooth-tui --title='Bluetooth' --override=colors.regular0=222226 --window-size-chars=82x26 dotfiles-bluetooth-tui"
    },
    "network": {
        "interval": 2,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤭",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "Ethernet\n{ipaddr}",
        "tooltip-format-disconnected": "Offline",
        "on-click": "foot --app-id=nmtui --title='Network Settings' --override=colors.regular0=222226 --window-size-chars=82x24 dotfiles-network-tui"
    },
    "custom/power-profile": {
        "exec": "dotfiles-waybar-power-status",
        "return-type": "json",
        "interval": 5,
        "on-click": "foot --app-id=power-profiles-tui --title='Power Profile' --override=colors.regular0=222226 --window-size-chars=82x24 dotfiles-power-profiles-tui"
    },
    "custom/power-menu": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "foot --app-id=power-menu-tui --title='Power' --override=colors.regular0=222226 --window-size-chars=88x23 dotfiles-power-menu-tui"
    },
    "custom/maintenance": {
        "exec": "dotfiles-waybar-maintenance-status",
        "return-type": "json",
        "interval": 300,
        "signal": 8,
        "on-click": "foot --app-id=maintenance-tui --title='Debian Maintenance' --override=colors.regular0=222226 --window-size-chars=104x32 dotfiles-maintenance-tui"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 16,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ]
    }
}
