{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "modules-left": [
        "tray",
        "hyprland/workspaces",
        "custom/temperature",
        "memory",
        "cpu",
        "custom/launcher"
    ],
    "modules-center": [
        "clock#time",
        "clock#date"
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "custom/notification",
        "pulseaudio",
        "custom/maintenance",
        "custom/power-profile",
        "custom/power-menu"
    ],

    "custom/launcher": {
        "format": "<span foreground='#38383c'></span><span background='#38383c'> 󰀻 </span>",
        "tooltip": false,
        "on-click": "dotfiles-app-launcher-toggle"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        },
        "sort-by": "number"
    },
    "clock#time": {
        "format": "<span background='#ffbe6f' foreground='#222226'> {:%I:%M %p} </span><span foreground='#ffbe6f'></span>",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui"
    },
    "clock#date": {
        "format": "<span background='#38383c'> {:%a %d %b} </span><span foreground='#38383c'></span>",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "<span foreground='#38383c'></span><span background='#38383c'> {icon} {text} </span>",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂚",
            "dnd-notification": "󱏨",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󱏨",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec": "dotfiles-waybar-notification-status",
        "interval": 5,
        "hide-empty-text": true,
        "on-click": "foot --app-id=notification-tui --title='Notifications' --override=colors.regular0=222226 --window-size-chars=94x28 dotfiles-notification-tui",
        "on-click-right": "makoctl mode -t do-not-disturb"
    },
    "cpu": {
        "format": "<span foreground='#38383c'></span><span background='#38383c'> 󰍛 {usage}% </span>",
        "interval": 2,
        "tooltip-format": "CPU: {usage}%",
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "memory": {
        "format": "<span foreground='#38383c'></span><span background='#38383c'>  {percentage}% </span>",
        "interval": 2,
        "tooltip-format": "Memory: {percentage}%",
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "custom/temperature": {
        "exec": "dotfiles-waybar-temperature-status",
        "return-type": "json",
        "format": "<span foreground='#38383c'></span><span background='#38383c'> {text} </span>",
        "interval": 5,
        "on-click": "foot --app-id=btop --title='System Monitor' --window-size-chars=120x36 dotfiles-system-monitor-tui"
    },
    "pulseaudio": {
        "format": "<span foreground='#38383c'></span><span background='#38383c'> {icon} {volume}% </span>",
        "format-muted": "<span foreground='#38383c'></span><span background='#38383c'> 󰖁 {volume}% </span>",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "foot --app-id=pulsemixer --title='Volume Mixer' --window-size-chars=94x28 pulsemixer"
    },
    "bluetooth": {
        "format": "<span foreground='#38383c'></span><span background='#38383c'> 󰂯 </span>",
        "format-disabled": "<span foreground='#38383c'></span><span background='#38383c'> 󰂲 </span>",
        "format-off": "<span foreground='#38383c'></span><span background='#38383c'> 󰂲 </span>",
        "format-on": "<span foreground='#38383c'></span><span background='#38383c'> 󰂯 </span>",
        "format-connected": "<span foreground='#38383c'></span><span background='#38383c'> 󰂱 {num_connections} </span>",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "foot --app-id=bluetooth-tui --title='Bluetooth' --override=colors.regular0=222226 --window-size-chars=82x26 dotfiles-bluetooth-tui"
    },
    "network": {
        "interval": 2,
        "format-wifi": "<span foreground='#38383c'></span><span background='#38383c'> {icon} </span>",
        "format-ethernet": "<span foreground='#38383c'></span><span background='#38383c'> 󰈀 </span>",
        "format-linked": "<span foreground='#38383c'></span><span background='#38383c'> 󰈀 </span>",
        "format-disconnected": "<span foreground='#38383c'></span><span background='#38383c'> 󰤭 </span>",
        "format-disabled": "<span foreground='#38383c'></span><span background='#38383c'> 󰤭 </span>",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "Ethernet\n{ipaddr}",
        "tooltip-format-disconnected": "Offline",
        "on-click": "foot --app-id=nmtui --title='Network Settings' --override=colors.regular0=222226 --window-size-chars=82x24 dotfiles-network-tui"
    },
    "custom/power-profile": {
        "exec": "dotfiles-waybar-power-status",
        "return-type": "json",
        "format": "<span foreground='#38383c'></span><span background='#38383c'> {text} </span>",
        "interval": 5,
        "on-click": "foot --app-id=power-profiles-tui --title='Power Profile' --override=colors.regular0=222226 --window-size-chars=82x24 dotfiles-power-profiles-tui"
    },
    "custom/power-menu": {
        "format": "<span foreground='#ffbe6f'></span><span background='#ffbe6f'> 󰐥 </span>",
        "tooltip": false,
        "on-click": "foot --app-id=power-menu-tui --title='Power' --override=colors.regular0=222226 --window-size-chars=88x23 dotfiles-power-menu-tui"
    },
    "custom/maintenance": {
        "exec": "dotfiles-waybar-maintenance-status",
        "return-type": "json",
        "format": "<span foreground='#38383c'></span><span background='#38383c'> {text} </span>",
        "interval": 300,
        "signal": 8,
        "on-click": "foot --app-id=maintenance-tui --title='Debian Maintenance' --override=colors.regular0=222226 --window-size-chars=104x32 dotfiles-maintenance-tui"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 16,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ]
    }
}
