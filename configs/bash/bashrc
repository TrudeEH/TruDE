# Interactive Bash configuration for the dotfiles environment.
[[ $- != *i* ]] && return

# Keep user-installed and dotfiles utilities available without growing PATH
# every time this file is sourced.
case :$PATH: in
    *:"$HOME/.local/bin":*) ;;
    *) PATH=$HOME/.local/bin:$PATH ;;
esac
case :$PATH: in
    *:"$HOME/dotfiles/scripts":*) ;;
    *) PATH=$HOME/dotfiles/scripts:$PATH ;;
esac
export PATH

# Prefer modern tools when installed without making them required.
if command -v batcat >/dev/null 2>&1; then
    alias cat='batcat'
elif command -v bat >/dev/null 2>&1; then
    alias cat='bat'
fi
if command -v micro >/dev/null 2>&1; then
    alias e='micro'
fi
if command -v lsd >/dev/null 2>&1; then
    alias lt='lsd --tree'
fi
if command -v tmux >/dev/null 2>&1; then
    alias t='tmux'
    alias ta='tmux attach'
fi

if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/superfile/env" ]; then
    . "${XDG_CONFIG_HOME:-$HOME/.config}/superfile/env"
fi

# Preserve n's directory-jump behavior using Superfile's documented lastdir file.
n() {
    local spf_lastdir spf_status
    spf_lastdir=${XDG_STATE_HOME:-$HOME/.local/state}/superfile/lastdir
    rm -f -- "$spf_lastdir"
    command spf "$@"
    spf_status=$?
    if [ "$spf_status" -eq 0 ] && [ -s "$spf_lastdir" ]; then
        # Superfile writes a shell-quoted cd command here.
        # shellcheck disable=SC1090
        . "$spf_lastdir"
    fi
    rm -f -- "$spf_lastdir"
    return "$spf_status"
}

alias l='ls -alh'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ll='ls -lhi'
alias la='ls -A'
alias df='df -h'
alias du='du -h'
alias free='free -h'
alias ip='ip -color=auto'
alias diff='diff --color=auto'
alias mkdir='mkdir -pv'
alias fm=spf

# History
HISTSIZE=50000
HISTFILESIZE=200000
HISTCONTROL=ignoredups:erasedups
HISTIGNORE='ls:ll:la:l:cd:pwd:exit:clear:history'

# Shell behavior
shopt -s histappend
shopt -s checkwinsize
shopt -s extglob
shopt -s globstar
shopt -s cdspell
shopt -s dirspell
shopt -s autocd
shopt -s cmdhist
shopt -s checkjobs
shopt -s no_empty_cmd_completion 2>/dev/null || true

# Readline completion and history navigation
bind 'set show-all-if-ambiguous on'
bind 'set completion-ignore-case off'
bind 'set completion-map-case on'
bind 'set mark-symlinked-directories on'
bind 'TAB:menu-complete'
bind '"\e[Z": menu-complete-backward'
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# Share history between open shells.
PROMPT_COMMAND="history -a; history -n; ${PROMPT_COMMAND:-}"

# Pager behavior for terminal-friendly output.
export LESS='-FRiMX'
export MANPAGER='less -R'
export BAT_PAGER='less -FR'

# Use the approachable terminal editor installed by these dotfiles.
export EDITOR="${EDITOR:-micro}"
export VISUAL="${VISUAL:-$EDITOR}"

# Prompt with exit status on failure, current directory, and job count.
__bash_prompt() {
    local exit_code=$?
    local reset='\[\e[0m\]'
    local bold='\[\e[1m\]'
    local dim='\[\e[2m\]'
    local white='\[\e[37m\]'
    local orange='\[\e[38;5;215m\]'
    local red='\[\e[31m\]'
    local status=''

    if [ "$exit_code" -ne 0 ]; then
        status=" ${red}x:$exit_code${reset}"
    fi

    PS1="\n[${white}\u${reset}@${dim}\h${reset}] ${bold}${orange}\w${reset}${status} ${dim}J:${reset}\j\n\\$ "
}
PROMPT_COMMAND="__bash_prompt; ${PROMPT_COMMAND:-}"
