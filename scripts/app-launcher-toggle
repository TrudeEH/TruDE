#!/bin/sh
set -u

addresses=$(hyprctl clients -j 2>/dev/null \
    | jq -r '.[] | select(.class == "app-launcher-tui") | .address' 2>/dev/null)

if [ -n "$addresses" ]; then
    printf '%s\n' "$addresses" | while IFS= read -r address; do
        [ -n "$address" ] || continue
        hyprctl dispatch "hl.dsp.window.close('address:$address')" >/dev/null 2>&1 || :
    done
    exit 0
fi

exec foot \
    --app-id=app-launcher-tui \
    --title=Applications \
    --override=colors.regular0=222226 \
    --window-size-chars=86x26 \
    dotfiles-app-launcher-tui
