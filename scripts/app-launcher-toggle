#!/bin/sh
set -u

pids=$(hyprctl clients -j 2>/dev/null \
    | jq -r '.[] | select(.class == "app-launcher-tui") | .pid' 2>/dev/null)

if [ -n "$pids" ]; then
    printf '%s\n' "$pids" | while IFS= read -r pid; do
        case $pid in *[!0-9]*|'') continue ;; esac
        kill "$pid" 2>/dev/null || :
    done
    exit 0
fi

exec foot \
    --app-id=app-launcher-tui \
    --title=Applications \
    --override=colors.regular0=222226 \
    --window-size-chars=86x26 \
    dotfiles-app-launcher-tui
