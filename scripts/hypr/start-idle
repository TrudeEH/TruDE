#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
preferences_file=$config_home/dotfiles/settings.json
runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/dotfiles-hypridle
runtime_config=$runtime_dir/hypridle.conf

timeouts='300 600 900'
if [ -f "$preferences_file" ]; then
    timeouts=$(jq -r '[
        (.laptop.idle_timeout // 300),
        (.laptop.screen_off_timeout // 600),
        (.laptop.suspend_timeout // 900)
    ] | @tsv' "$preferences_file" 2>/dev/null || printf '300\t600\t900')
fi
IFS="$(printf '\t')" read -r lock_timeout screen_timeout suspend_timeout <<EOF
$timeouts
EOF
case $lock_timeout in ''|*[!0-9]*) lock_timeout=300 ;; esac
case $screen_timeout in ''|*[!0-9]*) screen_timeout=600 ;; esac
case $suspend_timeout in ''|*[!0-9]*) suspend_timeout=900 ;; esac

umask 077
mkdir -p "$runtime_dir"
temporary_config=$(mktemp "$runtime_dir/hypridle.XXXXXX")
trap 'rm -f "$temporary_config"' EXIT HUP INT TERM

cat > "$temporary_config" <<EOF
general {
    lock_cmd = pidof hyprlock >/dev/null || hyprlock --config $HOME/.config/hypr/hyprlock.conf
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
}
EOF

if [ "$lock_timeout" -gt 0 ]; then
    cat >> "$temporary_config" <<EOF

listener {
    timeout = $lock_timeout
    on-timeout = pidof hyprlock >/dev/null || hyprlock --config $HOME/.config/hypr/hyprlock.conf
}
EOF
fi

if [ "$screen_timeout" -gt 0 ]; then
    cat >> "$temporary_config" <<EOF

listener {
    timeout = $screen_timeout
    on-timeout = hyprctl dispatch dpms off
    on-resume = hyprctl dispatch dpms on
}
EOF
fi

if [ "$suspend_timeout" -gt 0 ]; then
    cat >> "$temporary_config" <<EOF

listener {
    timeout = $suspend_timeout
    on-timeout = systemctl suspend
}
EOF
fi

mv "$temporary_config" "$runtime_config"
trap - EXIT HUP INT TERM

exec hypridle --config "$runtime_config"
