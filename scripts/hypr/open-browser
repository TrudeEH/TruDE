#!/bin/sh
set -eu

url=${1:-https://start.duckduckgo.com}
browser_desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
browser_app=${browser_desktop%.desktop}
browser_class=

if [ -n "$browser_desktop" ]; then
    data_dirs=${XDG_DATA_HOME:-"$HOME/.local/share"}:${XDG_DATA_DIRS:-"/usr/local/share:/usr/share"}:"$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share"
    saved_ifs=$IFS
    IFS=:
    set -- $data_dirs
    IFS=$saved_ifs

    for data_dir do
        desktop_file=$data_dir/applications/$browser_desktop
        if [ -r "$desktop_file" ]; then
            browser_class=$(awk -F= '
                $0 == "[Desktop Entry]" { in_entry = 1; next }
                /^\[/ { in_entry = 0 }
                in_entry && $1 == "StartupWMClass" {
                    print substr($0, index($0, "=") + 1)
                    exit
                }
            ' "$desktop_file")
            [ -n "$browser_class" ] || browser_class=$browser_app
            break
        fi
    done
fi

workspace=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' 2>/dev/null || true)
if [ -n "$workspace" ] && [ -n "$browser_app" ]; then
    address=$(hyprctl clients -j 2>/dev/null \
        | jq -r --arg class "$browser_class" --arg app "$browser_app" \
            '.[] | select(.class == $class or .initialClass == $class or .class == $app or .initialClass == $app) | .address' \
            2>/dev/null \
        | head -n 1)
else
    address=
fi

if [ -z "$address" ]; then
    exec xdg-open "$url"
fi

hyprctl dispatch movetoworkspace "$workspace,address:$address" >/dev/null
hyprctl dispatch focuswindow "address:$address" >/dev/null
