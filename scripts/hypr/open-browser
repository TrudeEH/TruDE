#!/bin/sh
set -eu

url=${1:-https://start.duckduckgo.com}
browser=$(xdg-settings get default-web-browser 2>/dev/null || true)

case $browser in
    firefox.desktop|firefox-esr.desktop)
        if command -v firefox-esr >/dev/null 2>&1; then
            exec firefox-esr --new-window "$url"
        fi
        exec firefox --new-window "$url"
        ;;
    org.mozilla.firefox.desktop)
        exec flatpak run org.mozilla.firefox --new-window "$url"
        ;;
    chromium.desktop|chromium-browser.desktop)
        exec chromium --new-window "$url"
        ;;
    org.chromium.Chromium.desktop)
        exec flatpak run org.chromium.Chromium --new-window "$url"
        ;;
    google-chrome.desktop)
        exec google-chrome --new-window "$url"
        ;;
    com.google.Chrome.desktop)
        exec flatpak run com.google.Chrome --new-window "$url"
        ;;
    brave-browser.desktop)
        exec brave-browser --new-window "$url"
        ;;
    com.brave.Browser.desktop)
        exec flatpak run com.brave.Browser --new-window "$url"
        ;;
    vivaldi-stable.desktop|vivaldi.desktop)
        exec vivaldi --new-window "$url"
        ;;
    *)
        exec xdg-open "$url"
        ;;
esac
