#!/bin/sh
set -u

addresses=$(hyprctl clients -j 2>/dev/null \
    | jq -r '.[] | select(.class == "app-launcher-tui") | .address' 2>/dev/null)

if [ -n "$addresses" ]; then
    while IFS= read -r address; do
        hex=${address#0x}
        case $hex in ''|*[!0-9a-fA-F]*) continue ;; esac
        dispatcher=$(printf 'hl.dsp.window.close({ window = "address:%s" })' "$address")
        hyprctl dispatch "$dispatcher" >/dev/null
    done <<EOF
$addresses
EOF
    exit 0
fi

exec footclient \
    --app-id=app-launcher-tui \
    --title=Applications \
    --override=colors.regular0=222226 \
    --window-size-chars=86x26 \
    dotfiles-app-launcher-tui
