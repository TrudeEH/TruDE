#!/bin/sh
set -eu

# shellcheck source=scripts/lib/runtime.sh
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/runtime.sh"

mode=${1:-region}
runtime_dir=$(dotfiles_runtime_dir) || exit 1
umask 077
# The kernel releases flock on exit, including an interrupted screenshot.
exec 9> "$runtime_dir/dotfiles-screenshot.flock"
flock -n 9 || exit 0

case "$mode" in
    region|full) ;;
    *)
        echo "Usage: $(basename "$0") [region|full]" >&2
        exit 2
        ;;
esac

if [ -n "${XDG_PICTURES_DIR:-}" ]; then
    pictures_dir=$XDG_PICTURES_DIR
elif command -v xdg-user-dir >/dev/null 2>&1; then
    pictures_dir=$(xdg-user-dir PICTURES)
    [ -n "$pictures_dir" ] || pictures_dir=$HOME/Pictures
else
    pictures_dir=$HOME/Pictures
fi
output_dir=$pictures_dir/Screenshots
output="$output_dir/screenshot-$(date +%Y%m%d-%H%M%S-%N).png"
mkdir -p "$output_dir"

if [ "$mode" = region ]; then
    if ! geometry=$(slurp); then
        exit 0
    fi
    [ -n "$geometry" ] || exit 0
    grim -g "$geometry" "$output"
else
    grim "$output"
fi

wl-copy --type image/png 9>&- < "$output"
printf 'Screenshot saved to %s\n' "$output"
