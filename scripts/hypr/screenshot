#!/bin/sh
set -eu

mode=${1:-region}
lock_dir=${XDG_RUNTIME_DIR:-/tmp}/dotfiles-screenshot.lock

# slurp keeps the selector open until the user confirms or cancels it. Make
# that interaction single-instance so repeated PrintScreen presses cannot
# create overlapping selectors.
if ! mkdir "$lock_dir" 2>/dev/null; then
    exit 0
fi
trap 'rmdir "$lock_dir"' 0 1 2 3 15

case "$mode" in
    region|full) ;;
    *)
        echo "Usage: $(basename "$0") [region|full]" >&2
        exit 2
        ;;
esac

if [ -n "${XDG_PICTURES_DIR:-}" ]; then
    pictures_dir=$XDG_PICTURES_DIR
elif command -v xdg-user-dir >/dev/null 2>&1; then
    pictures_dir=$(xdg-user-dir PICTURES)
    [ -n "$pictures_dir" ] || pictures_dir=$HOME/Pictures
else
    pictures_dir=$HOME/Pictures
fi
output_dir=$pictures_dir/Screenshots
output="$output_dir/screenshot-$(date +%Y%m%d-%H%M%S-%N).png"
mkdir -p "$output_dir"

if [ "$mode" = region ]; then
    if ! geometry=$(slurp); then
        exit 0
    fi
    [ -n "$geometry" ] || exit 0
    grim -g "$geometry" "$output"
else
    grim "$output"
fi

wl-copy --type image/png < "$output"
printf 'Screenshot saved to %s\n' "$output"
