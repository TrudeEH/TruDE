#!/bin/sh
set -eu
. "$(dirname -- "$(readlink -f -- "$0")")/common.sh"
exec 9>"$runtime/control.lock"
flock -n 9 || exit 0
case ${1:-toggle} in
    cancel)
        systemctl --user stop dotfiles-dictation.service
        rm -f "$runtime/state" "$runtime/error"
        refresh_launcher
        exit 0 ;;
    toggle) ;;
    *) printf 'Usage: %s [toggle|cancel]\n' "$0" >&2; exit 2 ;;
esac
if systemctl --user is-active --quiet dotfiles-dictation.service; then
    if [ "$(cat "$runtime/state" 2>/dev/null || :)" = recording ]; then
        : > "$runtime/stop"
    fi
    exit 0
fi
if ! jq -e '.dictation.enabled == true' "$preferences_file" >/dev/null 2>&1; then
    printf '%s\n' 'Enable Voice Dictation in Settings (Super+I) and download a model first.' > "$runtime/error"
    state dictation-error
    exit 0
fi
if ! model_ready "$model"; then
    printf '%s\n' 'Dictation engine or model missing. Open Voice Dictation in Settings.' > "$runtime/error"
    state dictation-error
    exit 0
fi
rm -f "$runtime/stop" "$runtime/error"
# Import the compositor environment from the shortcut, not a stale user manager.
systemctl --user import-environment WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE
systemctl --user start dotfiles-dictation.service
