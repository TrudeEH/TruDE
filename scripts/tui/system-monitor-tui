#!/bin/sh
set -u

# shellcheck source=scripts/lib/runtime.sh
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/runtime.sh"

runtime_dir=$(dotfiles_runtime_dir) || exit 1
config_root=$runtime_dir/dotfiles-btop
config_dir=$config_root/btop
theme_source=${XDG_CONFIG_HOME:-"$HOME/.config"}/btop/themes/dotfiles.theme

umask 077
mkdir -p "$config_dir/themes" || exit 1
ln -sf "$theme_source" "$config_dir/themes/dotfiles.theme"

if [ ! -f "$config_dir/btop.conf" ]; then
    printf '%s\n' \
        'color_theme = "dotfiles"' \
        'theme_background = False' \
        'truecolor = True' \
        'rounded_corners = False' \
        'graph_symbol = "braille"' \
        'shown_boxes = "cpu mem net proc"' \
        'update_ms = 2000' \
        'check_temp = True' \
        'temp_scale = "celsius"' \
        > "$config_dir/btop.conf"
fi

XDG_CONFIG_HOME=$config_root exec btop
