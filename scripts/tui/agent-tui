#!/bin/sh
set -eu
agent_dir=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")/../agent" && pwd)
agent_binary=$agent_dir/bin/seth
if [ ! -x "$agent_binary" ] || [ "$agent_dir/build.sh" -nt "$agent_binary" ] \
    || [ -n "$(find "$agent_dir/src" -type f \( -name '*.c' -o -name '*.h' \) -newer "$agent_binary" -print -quit 2>/dev/null)" ]; then
    "$agent_dir/build.sh"
fi
exec "$agent_binary" "$@"
