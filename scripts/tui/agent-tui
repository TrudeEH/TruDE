#!/bin/sh
set -eu
agent_dir=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")/../agent" && pwd)
case $(uname -m) in
    x86_64) agent_arch=amd64 ;;
    aarch64) agent_arch=arm64 ;;
    *) agent_arch=$(uname -m) ;;
esac
agent_binary=$agent_dir/bin/seth-$agent_arch
if [ ! -x "$agent_binary" ]; then
    printf 'No native Seth binary for %s. Rebuild with scripts/agent/build.sh on this Debian machine.\n' "$agent_arch" >&2
    exit 1
fi
exec "$agent_binary" "$@"
