#!/bin/sh
set -u

# shellcheck source=scripts/lib/ui.sh
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/ui.sh"
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dirs=${XDG_CONFIG_DIRS:-/etc/xdg}
autostart_dir=$config_home/autostart
temp_dir=$(mktemp -d) || exit 1
trap 'rm -rf "$temp_dir"' 0
trap 'exit 1' HUP INT TERM

dialog() { whiptail --title "Autostart" "$@"; }
message() { dialog --msgbox "$1" 16 88; }
confirm() { dialog --defaultno --yesno "$1" 14 88; }

# Never evaluate Exec or source a desktop file.
desktop_value() {
    awk -v key="$2" '
        { sub(/\r$/, "") }
        /^\[/ { entry = ($0 == "[Desktop Entry]"); next }
        entry && index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }
    ' "$1"
}

app_state() {
    if [ "$(desktop_value "$1" Hidden)" = true ] ||
        [ "$(desktop_value "$1" X-GNOME-Autostart-enabled)" = false ]; then
        printf Disabled
    else
        printf Enabled
    fi
}

# Per-user overrides preserve vendor files, desktop restrictions and other keys.
set_app_state() (
    source_file=$1
    hidden=$2
    target=$autostart_dir/$(basename -- "$source_file")
    mkdir -p "$autostart_dir" || exit 1
    new_file=$(mktemp "$autostart_dir/.autostart.XXXXXX") || exit 1
    trap 'rm -f "$new_file"' 0
    if ! awk -v hidden="$hidden" '
        function keys() {
            print "Hidden=" hidden
            print "X-GNOME-Autostart-enabled=" (hidden == "true" ? "false" : "true")
        }
        { sub(/\r$/, "") }
        /^\[/ {
            if (entry) keys()
            entry = ($0 == "[Desktop Entry]")
        }
        entry && /^(Hidden|X-GNOME-Autostart-enabled)=/ { next }
        { print }
        END { if (entry) keys() }
    ' "$source_file" > "$new_file" || ! chmod 600 "$new_file"; then
        exit 1
    fi
    if [ -e "$target" ]; then
        # Remove any backup symlink by replacing it atomically, not following it.
        backup=$(mktemp "$autostart_dir/.backup.XXXXXX") || exit 1
        if ! cp -- "$target" "$backup" || ! mv -f -- "$backup" "$target.backup"; then
            rm -f "$backup"
            exit 1
        fi
    fi
    # Rename replaces a symlink rather than editing its target.
    mv -f -- "$new_file" "$target"
)

manage_app() (
    file=$1
    while :; do
        name=$(desktop_value "$file" Name)
        state=$(app_state "$file")
        action=$(dialog --menu "${name:-$(basename -- "$file")} — $state\nChanges apply at next login; running apps are not stopped." 17 88 5 \
            toggle "Toggle login autostart" \
            details "Show entry and desktop restrictions" \
            back "Back" 3>&1 1>&2 2>&3) || return
        case $action in
            toggle)
                if [ "$state" = Enabled ]; then hidden=true; verb=Disable; else hidden=false; verb=Enable; fi
                confirm "$verb login autostart for ${name:-$file}?\n\nA user override will be saved. Desktop restrictions and TryExec still apply. Existing user entries are backed up as .desktop.backup." || continue
                if output=$(set_app_state "$file" "$hidden" 2>&1); then
                    file=$autostart_dir/$(basename -- "$file")
                    message "Autostart updated. The running application was not changed."
                else
                    message "Unable to save autostart entry:\n$output"
                fi
                ;;
            details) dialog --scrolltext --textbox "$file" 24 96 || : ;;
            back) return ;;
        esac
    done
)

applications() (
    while :; do
        : > "$temp_dir/apps"
        : > "$temp_dir/seen"
        index=0
        set --
        # User entry wins, then the first XDG system directory.
        dirs=$config_home:$config_dirs
        old_ifs=$IFS
        IFS=:
        set -f
        for dir in $dirs; do
            IFS=$old_ifs
            set +f
            [ -n "$dir" ] || continue
            for file in "$dir"/autostart/*.desktop; do
                [ -f "$file" ] || continue
                base=$(basename -- "$file")
                grep -Fqx -e "$base" "$temp_dir/seen" && continue
                printf '%s\n' "$base" >> "$temp_dir/seen"
                [ "$(desktop_value "$file" Type)" = Application ] || continue
                name=$(desktop_value "$file" Name)
                index=$((index + 1))
                printf '%s\n' "$file" >> "$temp_dir/apps"
                set -- "$@" "$index" "$(app_state "$file") — ${name:-$base}"
            done
            IFS=:
            set -f
        done
        set +f
        IFS=$old_ifs
        [ "$index" -gt 0 ] || { message "No XDG autostart applications found."; return; }
        choice=$(dialog --menu "Login applications\nEnabled means not disabled here; desktop restrictions may prevent startup." 24 96 15 "$@" 3>&1 1>&2 2>&3) || return
        file=$(sed -n "${choice}p" "$temp_dir/apps")
        [ -n "$file" ] && manage_app "$file"
    done
)

add_application() (
    file=$(dialog --inputbox "Absolute path to an existing application .desktop file\nExample: /usr/share/applications/example.desktop" 12 88 3>&1 1>&2 2>&3) || return
    case $file in /*.desktop) ;; *) message "Enter an absolute path ending in .desktop."; return ;; esac
    if [ ! -f "$file" ] || [ "$(desktop_value "$file" Type)" != Application ] ||
        [ -z "$(desktop_value "$file" Exec)" ]; then
        message "Select an Application .desktop file containing an Exec command."
        return
    fi
    name=$(desktop_value "$file" Name)
    confirm "Add ${name:-$file} to login autostart?\n\nOnly use trusted desktop files: their Exec command runs at login. An existing user entry with the same filename will be backed up and replaced." || return
    if output=$(set_app_state "$file" false 2>&1); then
        message "Application added. It will be eligible to start at next login."
    else
        message "Unable to add application:\n$output"
    fi
)

# Startup configuration and current runtime are deliberately separate.
ctl() {
    if [ "$scope" = user ]; then systemctl --user "$@"; else systemctl "$@"; fi
}

change_service() (
    if [ "$scope" = system ]; then
        command -v pkexec >/dev/null 2>&1 || { printf 'pkexec is required to change system services.\n'; return 1; }
        pkexec /usr/bin/systemctl "$1" "$2"
    else
        systemctl --user "$1" "$2"
    fi
)

manage_service() (
    unit=$1
    while :; do
        enabled=$(ctl is-enabled "$unit" 2>/dev/null || :)
        active=$(ctl is-active "$unit" 2>/dev/null || :)
        action=$(dialog --menu "$unit\nStartup: ${enabled:-unknown}    Runtime: ${active:-unknown}\nDisabling does not prevent dependency/socket activation." 20 96 7 \
            enable "Enable startup (does not start now)" \
            disable "Disable startup (does not stop now)" \
            start "Start now only" \
            stop "Stop now only" \
            details "Show unit, triggers and memory accounting" \
            back "Back" 3>&1 1>&2 2>&3) || return
        case $action in
            details)
                { ctl show "$unit" -p Description -p FragmentPath -p UnitFileState -p ActiveState -p MemoryCurrent -p TriggeredBy -p Triggers; ctl cat "$unit"; } > "$temp_dir/unit" 2>&1
                dialog --scrolltext --textbox "$temp_dir/unit" 24 96 || :
                ;;
            enable|disable|start|stop)
                case $action:$enabled in
                    enable:masked*|enable:static|enable:generated|enable:transient|disable:masked*|disable:static|disable:generated|disable:transient)
                        message "This unit is $enabled. Startup cannot be toggled here. Manage its activating dependency, timer or socket instead. Masked units are never unmasked automatically."
                        continue ;;
                esac
                warning=""
                [ "$scope" != system ] || warning="\n\nSystem changes affect every user. Changing essential services can break networking, login, authentication or power management."
                confirm "Run $action on $scope unit $unit?$warning\n\nEnable/disable changes startup only. Start/stop changes current runtime only." || continue
                if output=$(change_service "$action" "$unit" 2>&1); then
                    message "Completed $action for $unit."
                else
                    message "Unable to $action $unit:\n$output"
                fi
                ;;
            back) return ;;
        esac
    done
)

services() (
    scope=$1
    while :; do
        if ! ctl list-unit-files --type=service --type=timer --type=socket --no-legend --no-pager > "$temp_dir/units" 2> "$temp_dir/error"; then
            message "Unable to list $scope services:\n$(cat "$temp_dir/error")"
            return
        fi
        set --
        while read -r unit state remainder; do
            case $unit in *.service|*.timer|*.socket) ;; *) continue ;; esac
            set -- "$@" "$unit" "$state"
        done < "$temp_dir/units"
        [ "$#" -gt 0 ] || { message "No $scope service units found."; return; }
        unit=$(dialog --menu "$scope services, timers and sockets\nSelect a unit to inspect or change. Static units start through dependencies." 24 96 15 "$@" 3>&1 1>&2 2>&3) || return
        manage_service "$unit"
    done
)

while :; do
    action=$(dialog --menu "Manage startup without removing software.\nHyprland exec commands are not edited by this tool." 19 88 7 \
        applications "Login applications — XDG autostart" \
        add "Add a login application from a desktop file" \
        user "User services, timers and sockets" \
        system "System services, timers and sockets — administrator access" \
        close "Close" 3>&1 1>&2 2>&3) || exit 0
    case $action in
        applications) applications ;;
        add) add_application ;;
        user|system) services "$action" ;;
        close) exit 0 ;;
    esac
done
