#!/bin/sh
set -u

export NEWT_COLORS='root=white,black
border=white,black
window=white,black
shadow=black,black
title=yellow,black
button=black,yellow
actbutton=black,brown
compactbutton=white,black
checkbox=white,black
actcheckbox=black,yellow
entry=white,black
label=white,black
listbox=white,black
actlistbox=black,yellow
sellistbox=white,black
actsellistbox=black,yellow
textbox=white,black
acttextbox=black,yellow
emptyscale=white,black
fullscale=black,yellow
helpline=white,black
roottext=white,black'

dialog() {
    whiptail --title "Power" "$@"
}

confirm() {
    dialog --yesno "$1" 9 58
}

logout_session() {
    session_id=${XDG_SESSION_ID:-}
    if [ -n "$session_id" ] && loginctl terminate-session "$session_id" >/dev/null 2>&1; then
        return 0
    fi

    current_user=${USER:-$(id -un)}
    sessions=$(loginctl list-sessions --no-legend --no-pager 2>/dev/null || :)
    while read -r candidate _ username _ _ state _; do
        [ "$username" = "$current_user" ] || continue
        [ "$state" = active ] || continue
        session_type=$(loginctl show-session "$candidate" -p Type --value 2>/dev/null || :)
        if [ "$session_type" = wayland ] && loginctl terminate-session "$candidate" >/dev/null 2>&1; then
            return 0
        fi
    done <<EOF
$sessions
EOF

    if hyprctl dispatch exit >/dev/null 2>&1; then
        return 0
    fi

    dialog --msgbox "Could not log out. Hyprland could not be reached, and the current logind session could not be terminated." 10 72
    return 1
}

choice=$(dialog --menu "Choose an action" 17 64 8 \
    "󰌾 lock" "Lock the session" \
    "󰒲 suspend" "Suspend the computer" \
    "󰍃 logout" "Log out of Hyprland" \
    "󰜉 reboot" "Restart the computer" \
    "󰐥 poweroff" "Shut down the computer" \
    "󰜺 cancel" "Cancel" 3>&1 1>&2 2>&3) || exit 0

case $choice in
    *" lock")
        hyprlock --config "$HOME/.config/hypr/hyprlock.conf" >/dev/null 2>&1 &
        ;;
    *" suspend")
        confirm "Suspend the computer?" && systemctl suspend
        ;;
    *" logout")
        confirm "Log out of Hyprland?" && logout_session
        ;;
    *" reboot")
        confirm "Restart the computer?" && systemctl reboot
        ;;
    *" poweroff")
        confirm "Shut down the computer?" && systemctl poweroff
        ;;
    *" cancel") exit 0 ;;
esac
