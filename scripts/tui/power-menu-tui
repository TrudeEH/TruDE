#!/bin/sh
set -u

# shellcheck source=scripts/lib/ui.sh
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/ui.sh"

dialog() {
    whiptail --title "Power" "$@"
}

confirm() {
    dialog --yesno "$1" 9 58
}

session_locked() {
    hyprctl -j locked 2>/dev/null | jq -e '.locked == true' >/dev/null 2>&1
}

lock_session() {
    session_locked && return 0
    if ! pgrep -x hyprlock >/dev/null 2>&1; then
        # Let the lock survive when the power menu's terminal closes.
        setsid -f hyprlock --grace 0 --config "$HOME/.config/hypr/hyprlock.conf" \
            </dev/null >/dev/null 2>&1
    fi

    # A running process alone does not mean the compositor has locked yet.
    attempts=0
    while [ "$attempts" -lt 100 ]; do
        session_locked && return 0
        sleep 0.1
        attempts=$((attempts + 1))
    done
    dialog --msgbox "Unable to confirm that the session is locked." 10 72
    return 1
}

choice=$(dialog --menu "Choose an action" 17 64 8 \
    "󰌾 lock" "Lock the session" \
    "󰒲 suspend" "Suspend the computer" \
    "󰍃 logout" "Log out of Hyprland" \
    "󰜉 reboot" "Restart the computer" \
    "󰐥 poweroff" "Shut down the computer" \
    "󰜺 cancel" "Cancel" 3>&1 1>&2 2>&3) || exit 0

case $choice in
    *" lock")
        lock_session
        ;;
    *" suspend")
        confirm "Lock and suspend the computer?" && lock_session && systemctl suspend
        ;;
    *" logout")
        confirm "Log out of Hyprland?" && hyprctl dispatch 'hl.dsp.exit()'
        ;;
    *" reboot")
        confirm "Restart the computer?" && systemctl reboot
        ;;
    *" poweroff")
        confirm "Shut down the computer?" && systemctl poweroff
        ;;
    *" cancel") exit 0 ;;
esac
