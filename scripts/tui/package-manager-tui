#!/bin/sh
set -u

export NEWT_COLORS='root=white,black
border=white,black
window=white,black
shadow=black,black
title=yellow,black
button=black,yellow
actbutton=black,brown
compactbutton=white,black
checkbox=white,black
actcheckbox=black,yellow
entry=white,black
label=white,black
listbox=white,black
actlistbox=black,yellow
sellistbox=white,black
actsellistbox=black,yellow
textbox=white,black
acttextbox=black,yellow
emptyscale=white,black
fullscale=black,yellow
helpline=white,black
roottext=white,black'

temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-package-manager.XXXXXX") || exit 1
trap 'rm -rf "$temporary_dir"' EXIT HUP INT TERM

backports_suite=stable-backports

dialog() {
    whiptail --title "Package Manager" "$@"
}

message() {
    dialog --msgbox "$1" 10 78
}

pause_after_command() {
    printf '\nPress Enter to return to the package manager. '
    IFS= read -r _ || :
}

compact_text() {
    printf '%s\n' "$1" | awk '
        {
            gsub(/[[:space:]]+/, " ")
            if (length($0) > 86) {
                print substr($0, 1, 83) "..."
            } else {
                print
            }
        }
    '
}

has_stable_package() {
    package_name=$1
    apt-cache policy "$package_name" 2>/dev/null | awk '
        /stable-backports\// { next }
        index($0, "stable/") ||
        index($0, "stable-updates/") ||
        index($0, "stable-security/") { found=1 }
        END { exit !found }
    '
}

has_backports_package() {
    package_name=$1
    apt-cache policy "$package_name" 2>/dev/null | awk -v suite="$backports_suite" '
        index($0, suite "/") { found=1 }
        END { exit !found }
    '
}

backports_version() {
    package_name=$1
    apt-cache policy "$package_name" 2>/dev/null | awk -v suite="$backports_suite" '
        /^[[:space:]]+[0-9][^[:space:]]*[[:space:]]*$/ { version=$1 }
        /^[[:space:]]+\*+ [0-9]/ { version=$2 }
        index($0, suite "/") && version != "" {
            print version
            exit
        }
    '
}

create_apt_search_results() {
    query=$1
    source=$2
    raw_file=$temporary_dir/apt-search-raw
    results_file=$temporary_dir/apt-search-results

    apt-cache search "$query" 2>/dev/null | awk '
        {
            separator = index($0, " - ")
            if (!separator) next
            package = substr($0, 1, separator - 1)
            description = substr($0, separator + 3)
            gsub(/[[:space:]]+/, " ", description)
            if (package != "") print package "\t" description
        }
    ' > "$raw_file"

    : > "$results_file"
    result_count=0
    while IFS="$(printf '\t')" read -r package description; do
        [ -n "$package" ] || continue
        case $source in
            apt) has_stable_package "$package" || continue ;;
            backports) has_backports_package "$package" || continue ;;
        esac
        if awk -F '\t' -v package="$package" '$1 == package { found=1; exit } END { exit !found }' "$results_file"; then
            continue
        fi
        version=
        [ "$source" = backports ] && version=$(backports_version "$package")
        description=$(compact_text "$description")
        if [ -n "$version" ]; then
            description="$description — $version"
        fi
        printf '%s\t%s\n' "$package" "$description" >> "$results_file"
        result_count=$((result_count + 1))
        [ "$result_count" -ge 80 ] && break
    done < "$raw_file"

    printf '%s\n' "$results_file"
}

run_apt_install() {
    source=$1
    package=$2
    case $source in
        apt)
            command_description="Debian package"
            ;;
        backports)
            command_description="Debian Backports package"
            ;;
    esac

    if ! dialog --yesno "Install $command_description:\n\n$package\n\nAPT may install additional dependencies." 12 78; then
        return
    fi

    clear
    printf 'Installing %s: %s\n\n' "$command_description" "$package"
    if [ "$source" = backports ]; then
        sudo apt-get install -y -t "$backports_suite" -- "$package"
        status=$?
    else
        sudo apt-get install -y -- "$package"
        status=$?
    fi
    if [ "$status" -eq 0 ]; then
        printf '\nInstallation completed successfully.\n'
    else
        printf '\nInstallation failed.\n'
    fi
    pause_after_command
}

install_deb_file() {
    command -v nnn >/dev/null 2>&1 || {
        message 'nnn is required to select a local .deb package.'
        return
    }

    config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
    if [ -r "$config_dir/nnn/env" ]; then
        . "$config_dir/nnn/env"
    fi

    selection_file=$temporary_dir/nnn-selection
    start_dir=$HOME
    [ -d "$HOME/Downloads" ] && start_dir=$HOME/Downloads

    clear
    printf 'Select a .deb package in nnn. Press Enter on a file to choose it; Ctrl-G cancels.\n\n'
    nnn -p "$selection_file" "$start_dir"
    picker_status=$?
    clear
    [ "$picker_status" -eq 0 ] && [ -s "$selection_file" ] || return

    selection_count=$(wc -l < "$selection_file")
    [ "$selection_count" -eq 1 ] || {
        message 'Select one .deb package at a time.'
        return
    }
    deb_path=$(cat "$selection_file")

    case $deb_path in
        *.deb) ;;
        *)
            message 'The selected file must have a .deb extension.'
            return
            ;;
    esac

    case $deb_path in
        /*) ;;
        *) deb_path=$PWD/$deb_path ;;
    esac

    [ -f "$deb_path" ] && [ -r "$deb_path" ] || {
        message "Cannot read package file:\n\n$deb_path"
        return
    }

    if ! dialog --yesno "Install local Debian package?\n\n$deb_path\n\nAPT may install additional dependencies." 12 86; then
        return
    fi

    clear
    printf 'Installing local Debian package: %s\n\n' "$deb_path"
    sudo apt-get install -y -- "$deb_path"
    status=$?
    if [ "$status" -eq 0 ]; then
        printf '\nInstallation completed successfully.\n'
    else
        printf '\nInstallation failed.\n'
    fi
    pause_after_command
}

create_flatpak_search_results() {
    query=$1
    raw_file=$temporary_dir/flatpak-search-raw
    results_file=$temporary_dir/flatpak-search-results

    if ! flatpak search --user --columns=application,name,version,remotes,description "$query" \
        > "$raw_file" 2> "$temporary_dir/flatpak-search-error"; then
        error=$(sed -n '1,4p' "$temporary_dir/flatpak-search-error")
        message "Flatpak search failed.\n\n${error:-No Flatpak remotes are available.}"
        return 1
    fi

    : > "$results_file"
    awk -F '\t' '
        NF >= 1 && $1 != "" {
            name = $2
            version = $3
            remote = $4
            description = $5
            gsub(/[[:space:]]+/, " ", description)
            if (name == "") name = $1
            if (remote == "") remote = "flathub"
            printf "%s\t%s\t%s\t%s\t%s\n", $1, name, version, remote, description
        }
    ' "$raw_file" | awk -F '\t' '!seen[$1]++ { print }' | sed -n '1,80p' > "$results_file"

    printf '%s\n' "$results_file"
}

create_unified_install_results() {
    query=$1
    results_file=$temporary_dir/install-results
    : > "$results_file"

    apt_results=$(create_apt_search_results "$query" apt)
    while IFS="$(printf '\t')" read -r package description; do
        [ -n "$package" ] || continue
        printf 'apt\t%s\t󰏗  Debian · %s\t\n' "$package" "$description" >> "$results_file"
    done < "$apt_results"

    backports_results=$(create_apt_search_results "$query" backports)
    while IFS="$(printf '\t')" read -r package description; do
        [ -n "$package" ] || continue
        printf 'backports\t%s\t󰒓  Backports · %s\t\n' "$package" "$description" >> "$results_file"
    done < "$backports_results"

    if command -v flatpak >/dev/null 2>&1; then
        flatpak_results=$(create_flatpak_search_results "$query") || flatpak_results=
        if [ -n "$flatpak_results" ] && [ -s "$flatpak_results" ]; then
            while IFS="$(printf '\t')" read -r application name version remote description; do
                [ -n "$application" ] || continue
                label="$name"
                [ -n "$version" ] && label="$label — $version"
                [ -n "$description" ] && label="$label — $(compact_text "$description")"
                printf 'flatpak\t%s\t󰏖  Flatpak · %s · %s\t%s\n' \
                    "$application" "$remote" "$label" "$remote" >> "$results_file"
            done < "$flatpak_results"
        fi
    fi

    printf '%s\n' "$results_file"
}

select_install_package() {
    query=$(dialog --inputbox 'Search Debian packages, Backports, and Flatpaks:' 10 78 "" \
        3>&1 1>&2 2>&3) || return 1
    [ -n "$query" ] || return 1

    results_file=$(create_unified_install_results "$query")
    [ -s "$results_file" ] || {
        message "No installable packages matched that search."
        return 1
    }

    set --
    while IFS="$(printf '\t')" read -r source identifier label remote; do
        [ -n "$identifier" ] || continue
        set -- "$@" "$source:$identifier" "$label"
    done < "$results_file"

    selected=$(dialog --menu "Install results for: $query" 24 112 16 "$@" \
        3>&1 1>&2 2>&3) || return 1
    printf '%s\n' "$selected"
}

run_flatpak_install() {
    application=$1
    remote=$2
    if ! dialog --yesno "Install Flatpak application:\n\n$application\nRemote: $remote" 12 78; then
        return
    fi

    clear
    printf 'Installing Flatpak application: %s\n\n' "$application"
    flatpak install --user -y --or-update "$remote" "$application"
    status=$?
    if [ "$status" -eq 0 ]; then
        printf '\nFlatpak installation completed successfully.\n'
    else
        printf '\nFlatpak installation failed.\n'
    fi
    pause_after_command
}

install_package() {
    selected=$(select_install_package) || return
    source=${selected%%:*}
    identifier=${selected#*:}

    case $source in
        apt|backports)
            run_apt_install "$source" "$identifier"
            ;;
        flatpak)
            remote=$(awk -F '\t' -v application="$identifier" \
                '$1 == "flatpak" && $2 == application { print $4; exit }' "$temporary_dir/install-results")
            [ -n "$remote" ] || remote=flathub
            run_flatpak_install "$identifier" "$remote"
            ;;
    esac
}

create_installed_package_results() {
    results_file=$temporary_dir/installed-package-results
    : > "$results_file"
    debian_color=$(printf '\033[38;2;255;190;111m')
    backports_color=$(printf '\033[38;2;255;163;72m')
    flatpak_color=$(printf '\033[38;2;255;255;255m')
    package_color=$(printf '\033[38;2;255;255;255m')
    muted_color=$(printf '\033[38;2;170;170;170m')
    reset_color=$(printf '\033[0m')

    dpkg-query -W -f='${binary:Package}\t${Version}\t${Essential}\t${Status}\n' 2>/dev/null \
        | awk -F '\t' \
            -v source_color="$debian_color" \
            -v backports_color="$backports_color" \
            -v package_color="$package_color" \
            -v muted_color="$muted_color" \
            -v reset_color="$reset_color" '
            $4 ~ /installed$/ {
                color = source_color
                source = "󰏗  Debian ·"
                if ($2 ~ /~bpo/) {
                    color = backports_color
                    source = "󰒓  Backports ·"
                }
                label = color source reset_color " " package_color $1 reset_color " " muted_color "— " $2 reset_color
                if ($3 == "yes") label = label " " color "[essential]" reset_color
                print "apt\t" $1 "\t" label
            }
        ' >> "$results_file"

    if command -v flatpak >/dev/null 2>&1; then
        for scope in user system; do
            flatpak list --"$scope" --app --columns=application,name,version 2>/dev/null \
                | awk -F '\t' \
                    -v source="flatpak-"$scope \
                    -v source_color="$flatpak_color" \
                    -v package_color="$package_color" \
                    -v muted_color="$muted_color" \
                    -v reset_color="$reset_color" '
                    NF >= 1 && $1 != "" {
                        label = source_color "󰏖  Flatpak " substr(source, 9) " ·" reset_color " " package_color $2 reset_color
                        if ($3 != "") label = label " " muted_color "— " $3 reset_color
                        label = label " " muted_color "(" $1 ")" reset_color
                        print source "\t" $1 "\t" label
                    }
                ' >> "$results_file"
        done
    fi

    LC_ALL=C sort -f -t "$(printf '\t')" -k3,3 "$results_file" > "$results_file.sorted"
    mv "$results_file.sorted" "$results_file"
}

select_installed_package() {
    command -v fzf >/dev/null 2>&1 || {
        message "fzf is required to search installed packages."
        return 1
    }

    create_installed_package_results
    results_file=$temporary_dir/installed-package-results
    [ -s "$results_file" ] || {
        message "No installed Debian packages or Flatpaks were found."
        return 1
    }

    selected=$(fzf \
        --ansi \
        --delimiter='\t' \
        --with-nth=3 \
        --nth=3 \
        --prompt='󰏖  Remove package  ' \
        --pointer='󰜴' \
        --marker='󰄬' \
        --border=sharp \
        --border-label=" Installed packages: $(wc -l < "$results_file") " \
        --header='Type to search all installed Debian packages and Flatpaks' \
        --info=inline-right \
        --layout=reverse \
        --no-multi \
        --no-hscroll \
        --cycle \
        --color='bg:#222226,bg+:#38383c,fg:#ffffff,fg+:#ffffff,hl:#ffbe6f,hl+:#ffa348,prompt:#ffbe6f,pointer:#ffbe6f,marker:#ffbe6f,border:#55555a,label:#aaaaaa,info:#aaaaaa,spinner:#ffbe6f,header:#aaaaaa' \
        < "$results_file") || return 1

    source=$(printf '%s\n' "$selected" | cut -f1)
    identifier=$(printf '%s\n' "$selected" | cut -f2)
    printf '%s:%s\n' "$source" "$identifier"
}

remove_debian_package() {
    package=$1
    preview_file=$temporary_dir/apt-remove-preview
    apt-get -s remove -- "$package" > "$preview_file" 2>&1
    preview_status=$?
    if [ "$preview_status" -ne 0 ]; then
        message "APT could not prepare the removal:\n\n$(sed -n '1,12p' "$preview_file")"
        return
    fi

    preview=$(sed -n '/The following packages will be REMOVED:/,/^0 upgraded/p' "$preview_file" | sed -n '1,18p')
    [ -n "$preview" ] || preview=$(sed -n '1,18p' "$preview_file")
    essential=$(dpkg-query -W -f='${Essential}' "$package" 2>/dev/null || :)
    warning=
    [ "$essential" = yes ] && warning='\n\nWARNING: This package is marked essential.'
    if ! dialog --yesno "Remove Debian package $package?$warning\n\n$preview\n\nConfiguration files will be kept." 24 100; then
        return
    fi

    clear
    printf 'Removing Debian package: %s\n\n' "$package"
    sudo apt-get remove -y -- "$package"
    status=$?
    if [ "$status" -eq 0 ]; then
        printf '\nPackage removal completed successfully.\n'
    else
        printf '\nPackage removal failed.\n'
    fi
    pause_after_command
}

remove_flatpak_application() {
    scope=$1
    application=$2
    if ! dialog --yesno "Uninstall Flatpak application?\n\n$application\nInstallation: $scope\n\nApplication data will be kept." 14 78; then
        return
    fi

    clear
    printf 'Uninstalling Flatpak application: %s\n\n' "$application"
    if [ "$scope" = user ]; then
        flatpak uninstall --user -y "$application"
        status=$?
    else
        sudo flatpak uninstall --system -y "$application"
        status=$?
    fi
    if [ "$status" -eq 0 ]; then
        printf '\nFlatpak removal completed successfully.\n'
    else
        printf '\nFlatpak removal failed.\n'
    fi
    pause_after_command
}

remove_package() {
    selected=$(select_installed_package) || return
    source=${selected%%:*}
    identifier=${selected#*:}

    case $source in
        apt)
            remove_debian_package "$identifier"
            ;;
        flatpak-user|flatpak-system)
            scope=${source#flatpak-}
            remove_flatpak_application "$scope" "$identifier"
            ;;
    esac
}

refresh_apt_metadata() {
    if ! dialog --yesno 'Refresh Debian package lists now? This may take a moment.' 10 78; then
        return
    fi

    clear
    printf 'Refreshing Debian package lists…\n\n'
    sudo apt-get update
    status=$?
    if [ "$status" -eq 0 ]; then
        printf '\nAPT metadata refreshed successfully.\n'
    else
        printf '\nAPT metadata refresh failed.\n'
    fi
    pause_after_command
}

command -v whiptail >/dev/null 2>&1 || exit 1
command -v apt-cache >/dev/null 2>&1 || {
    message 'APT is unavailable on this system.'
    exit 1
}

while :; do
    choice=$(dialog --menu 'Choose whether to install or uninstall a package.' 18 94 7 \
        '󰐕  install' 'Search and install a Debian package, Backport, or Flatpak' \
        '󰏗  install-deb' 'Install a local .deb package file' \
        '󰏖  remove' 'Search and uninstall an installed Debian package or Flatpak' \
        '󰑐  refresh' 'Refresh Debian package lists' \
        '󰅖  close' 'Close' \
        3>&1 1>&2 2>&3) || exit 0

    case $choice in
        '󰐕  install') install_package ;;
        '󰏗  install-deb') install_deb_file ;;
        '󰏖  remove') remove_package ;;
        '󰑐  refresh') refresh_apt_metadata ;;
        '󰅖  close') exit 0 ;;
    esac
done
