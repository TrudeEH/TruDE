#!/bin/sh
set -u

cache_root=${XDG_CACHE_HOME:-"$HOME/.cache"}/dotfiles
cache_file=$cache_root/applications-v3.tsv
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
data_dirs=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
search_dirs=$data_home:$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:$data_dirs

mkdir -p "$cache_root"

cache_is_current() {
    [ -f "$cache_file" ] || return 1

    old_ifs=$IFS
    IFS=:
    for data_dir in $search_dirs; do
        applications_dir=$data_dir/applications
        [ -d "$applications_dir" ] || continue

        if [ "$applications_dir" -nt "$cache_file" ] \
            || find -L "$applications_dir" -type f -name '*.desktop' -newer "$cache_file" -print -quit 2>/dev/null \
                | grep -q .; then
            IFS=$old_ifs
            return 1
        fi
    done
    IFS=$old_ifs
}

rebuild_cache() {
    temporary=$(mktemp "$cache_root/applications.XXXXXX") || exit 1
    candidates=$(mktemp "$cache_root/applications-candidates.XXXXXX") || {
        rm -f "$temporary"
        exit 1
    }
    trap 'rm -f "$temporary" "$candidates"' EXIT HUP INT TERM

    old_ifs=$IFS
    IFS=:
    for data_dir in $search_dirs; do
        applications_dir=$data_dir/applications
        [ -d "$applications_dir" ] || continue

        find -L "$applications_dir" -type f -name '*.desktop' -print 2>/dev/null \
            | LC_ALL=C sort \
            | while IFS= read -r desktop_file; do
                relative=${desktop_file#"$applications_dir"/}
                printf '%s\t%s\n' "$relative" "$desktop_file"
            done >> "$candidates"
    done
    IFS=$old_ifs

    awk -F '\t' '
        function parse_desktop_file(path, line, section, type, name, comment, command, terminal, hidden) {
            while ((getline line < path) > 0) {
                if (line == "[Desktop Entry]") {
                    section = 1
                    continue
                }
                if (line ~ /^\[/) {
                    if (section) {
                        break
                    }
                    continue
                }
                if (!section) {
                    continue
                }
                if (line ~ /^Type=/) {
                    type = substr(line, 6)
                } else if (line ~ /^Name=/ && name == "") {
                    name = substr(line, 6)
                } else if (line ~ /^Comment=/ && comment == "") {
                    comment = substr(line, 9)
                } else if (line ~ /^Exec=/ && command == "") {
                    command = substr(line, 6)
                } else if (tolower(line) == "terminal=true") {
                    terminal = 1
                } else if (tolower(line) ~ /^(hidden|nodisplay)=true$/) {
                    hidden = 1
                }
            }
            close(path)

            if (type == "Application" && name != "" && command != "" && !terminal && !hidden) {
                gsub(/\t/, " ", name)
                gsub(/\t/, " ", comment)
                printf "%s\t%s\t%s\n", name, comment, path
            }
        }
        {
            desktop_id = $1
            gsub(/\//, "-", desktop_id)
            if (!seen[desktop_id]++) {
                parse_desktop_file($2)
            }
        }
    ' "$candidates" > "$temporary"

    LC_ALL=C sort -f -k1,1 "$temporary" -o "$temporary"
    mv "$temporary" "$cache_file"
    rm -f "$candidates"
    trap - EXIT HUP INT TERM
}

cache_is_current || rebuild_cache

selection=$(awk -F '\t' '
    BEGIN {
        OFS = "\t"
        muted = "\033[38;2;170;170;170m"
        reset = "\033[0m"
    }
    {
        names[NR] = $1
        descriptions[NR] = $2
        desktop_files[NR] = $3
        if (length($1) > name_width) {
            name_width = length($1)
        }
    }
    END {
        for (row = 1; row <= NR; row++) {
            description = descriptions[row]
            if (description != "") {
                description = muted description reset
            }
            printf "%-*s\t%s\t%s\n", name_width + 2, names[row], description, desktop_files[row]
        }
    }
' "$cache_file" | fzf \
    --ansi \
    --delimiter='\t' \
    --with-nth=1,2 \
    --nth=1,2 \
    --tiebreak=begin,length,index \
    --prompt='󰀻  Search apps  ' \
    --pointer='󰜴' \
    --marker='󰄬' \
    --border=sharp \
    --border-label=' Applications ' \
    --info=inline-right \
    --layout=reverse \
    --no-multi \
    --cycle \
    --color='bg:#222226,bg+:#38383c,fg:#ffffff,fg+:#ffffff,hl:#ffbe6f,hl+:#ffa348,prompt:#ffbe6f,pointer:#ffbe6f,marker:#ffbe6f,border:#55555a,label:#aaaaaa,info:#aaaaaa,spinner:#ffbe6f,header:#aaaaaa') || exit 0

desktop_file=$(printf '%s\n' "$selection" | awk -F '\t' '{ print $NF }')
[ -f "$desktop_file" ] || exit 1

setsid -f dex "$desktop_file" >/dev/null 2>&1
