#!/bin/sh
set -u

# shellcheck source=scripts/lib/ui.sh
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/ui.sh"

usage() {
    printf 'Usage: %s\n\n' "${0##*/}"
    printf 'Search the installed Nerd Font glyphs and copy a selected icon.\n'
    printf 'Use --print to write the selected icon to standard output instead.\n'
    printf 'Set DOTFILES_NERDFONT_FAMILY to choose a specific installed font.\n'
}

output_mode=clipboard
if [ "$#" -gt 0 ]; then
    case $1 in
        --print) output_mode=stdout; shift ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
fi

for command in fc-list fc-match fzf od awk sort; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'icon_picker.sh: %s is required.\n' "$command" >&2
        exit 1
    fi
done

font_family=${DOTFILES_NERDFONT_FAMILY:-}
if [ -n "$font_family" ]; then
    font_file=$(fc-match -f '%{file}' "$font_family" 2>/dev/null || :)
else
    font_file=$(fc-list --format='%{family}\t%{file}\n' 2>/dev/null \
        | awk -F '	' 'tolower($1) ~ /nerd font/ { print $2; exit }')
fi

if [ -z "$font_file" ] || [ ! -r "$font_file" ]; then
    printf 'icon_picker.sh: no readable Nerd Font was found.\n' >&2
    printf 'Set DOTFILES_NERDFONT_FAMILY to an installed Nerd Font family.\n' >&2
    exit 1
fi

if [ "$output_mode" = clipboard ]; then
    clipboard=
    for command in wl-copy xclip xsel pbcopy; do
        if command -v "$command" >/dev/null 2>&1; then
            clipboard=$command
            break
        fi
    done

    if [ -z "$clipboard" ]; then
        printf 'icon_picker.sh: no clipboard command found (tried wl-copy, xclip, xsel, pbcopy).\n' >&2
        exit 1
    fi
fi

terminal_columns=$(tput cols 2>/dev/null || printf '80')
case $terminal_columns in
    ''|*[!0-9]*) terminal_columns=80 ;;
esac

list_font_icons() {
    # Read the SFNT directory, then only the cmap and post tables. Keeping the
    # font outlines out of awk avoids loading the entire font into byte arrays.
    directory_size=$(od -An -v -tu1 -N 12 "$font_file" | awk '
        { for (i = 1; i <= NF; i++) bytes[n++] = $i }
        END {
            if (n != 12) exit 1
            print 12 + 16 * (bytes[4] * 256 + bytes[5])
        }
    ') || {
        printf 'Icon picker: font header is unreadable or truncated.\n' >&2
        return 1
    }
    table_locations=$(od -An -v -tu1 -N "$directory_size" "$font_file" | awk '
        function u32(offset) {
            return ((bytes[offset] * 256 + bytes[offset + 1]) * 256 + bytes[offset + 2]) * 256 + bytes[offset + 3]
        }
        { for (i = 1; i <= NF; i++) bytes[n++] = $i }
        END {
            if (n < 12 || n != 12 + 16 * (bytes[4] * 256 + bytes[5])) exit 1
            for (offset = 12; offset < n; offset += 16) {
                tag = sprintf("%c%c%c%c", bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3])
                if (tag == "cmap") { cmap_offset = u32(offset + 8); cmap_length = u32(offset + 12) }
                if (tag == "post") { post_offset = u32(offset + 8); post_length = u32(offset + 12) }
            }
            if (!cmap_length || !post_length) exit 1
            printf "%.0f %.0f %.0f %.0f\n", cmap_offset, cmap_length, post_offset, post_length
        }
    ') || {
        printf 'Icon picker: font has no readable cmap/post glyph tables.\n' >&2
        return 1
    }
    read -r cmap_offset cmap_length post_offset post_length <<EOF
$table_locations
EOF
    {
        od -An -v -tu1 -j "$cmap_offset" -N "$cmap_length" "$font_file"
        od -An -v -tu1 -j "$post_offset" -N "$post_length" "$font_file"
    } | LC_ALL=C awk -v cmap_length="$cmap_length" -v post_length="$post_length" '
        function fail(message) {
            print "Icon picker: " message > "/dev/stderr"
            exit 1
        }
        function byte(data, offset) {
            if (!(offset in data)) fail("truncated glyph table.")
            return data[offset]
        }
        function u16(data, offset) {
            return byte(data, offset) * 256 + byte(data, offset + 1)
        }
        function u32(data, offset) {
            return u16(data, offset) * 65536 + u16(data, offset + 2)
        }
        function utf8(codepoint) {
            if (codepoint < 65536)
                return sprintf("%c%c%c", 224 + int(codepoint / 4096), 128 + int(codepoint / 64) % 64, 128 + codepoint % 64)
            return sprintf("%c%c%c%c", 240 + int(codepoint / 262144), 128 + int(codepoint / 4096) % 64, 128 + int(codepoint / 64) % 64, 128 + codepoint % 64)
        }
        function emit(codepoint, glyph, name) {
            name = names[glyph]
            if (glyph && name != "" && name != ".notdef") {
                gsub(/_/, "-", name)
                printf "%s\t%s\tU+%04X\n", utf8(codepoint), name, codepoint
            }
        }
        {
            for (field = 1; field <= NF; field++) {
                if (n < cmap_length) cmap[n] = $field
                else post[n - cmap_length] = $field
                n++
            }
        }
        END {
            if (n != cmap_length + post_length) fail("truncated glyph tables.")
            if (u32(post, 0) != 131072) fail("font does not contain searchable glyph names.")

            # Version 2 of post maps glyph IDs to Pascal strings after an index
            # array. Nerd Font names use these custom strings (indices >= 258).
            glyph_count = u16(post, 32)
            cursor = 34 + glyph_count * 2
            for (glyph = 0; glyph < glyph_count; glyph++) {
                name_index = u16(post, 34 + glyph * 2)
                name_indices[glyph] = name_index
                if (name_index > max_index) max_index = name_index
            }
            for (name_index = 258; name_index <= max_index; name_index++) {
                size = byte(post, cursor++)
                name = ""
                for (character = 0; character < size; character++) name = name sprintf("%c", byte(post, cursor++))
                custom_names[name_index] = name
            }
            for (glyph = 0; glyph < glyph_count; glyph++) names[glyph] = custom_names[name_indices[glyph]]

            # Prefer a full Unicode cmap; retain support for BMP-only format 4.
            records = u16(cmap, 2)
            for (record = 0; record < records; record++) {
                offset = 4 + record * 8
                platform = u16(cmap, offset)
                encoding = u16(cmap, offset + 2)
                subtable = u32(cmap, offset + 4)
                format = u16(cmap, subtable)
                priority = 0
                if (format == 12 || format == 13) priority = platform == 3 && encoding == 10 ? 3 : 2
                else if (format == 4) priority = platform == 3 ? 2 : 1
                if (priority > best_priority || (priority == best_priority && priority &&
                    (format > best_format || (format == best_format && subtable > best_subtable)))) {
                    best_priority = priority
                    best_format = format
                    best_subtable = subtable
                }
            }
            if (!best_priority) fail("font has no supported Unicode glyph mapping.")
            range_start[1] = 57344; range_end[1] = 63743
            range_start[2] = 983040; range_end[2] = 1048573
            range_start[3] = 1048576; range_end[3] = 1114109

            if (best_format == 12 || best_format == 13) {
                groups = u32(cmap, best_subtable + 12)
                if (best_subtable + 16 + groups * 12 > cmap_length) fail("truncated Unicode glyph groups.")
                for (group = 0; group < groups; group++) {
                    offset = best_subtable + 16 + group * 12
                    first = u32(cmap, offset)
                    last = u32(cmap, offset + 4)
                    base_glyph = u32(cmap, offset + 8)
                    for (range = 1; range <= 3; range++) {
                        start = first > range_start[range] ? first : range_start[range]
                        end = last < range_end[range] ? last : range_end[range]
                        for (codepoint = start; codepoint <= end; codepoint++)
                            emit(codepoint, best_format == 13 ? base_glyph : base_glyph + codepoint - first)
                    }
                }
            } else {
                segments = u16(cmap, best_subtable + 6) / 2
                end_codes = best_subtable + 14
                start_codes = end_codes + segments * 2 + 2
                deltas = start_codes + segments * 2
                range_offsets = deltas + segments * 2
                for (segment = 0; segment < segments; segment++) {
                    first = u16(cmap, start_codes + segment * 2)
                    last = u16(cmap, end_codes + segment * 2)
                    delta = u16(cmap, deltas + segment * 2)
                    range_offset = u16(cmap, range_offsets + segment * 2)
                    start = first > range_start[1] ? first : range_start[1]
                    end = last < range_end[1] ? last : range_end[1]
                    for (codepoint = start; codepoint <= end; codepoint++) {
                        glyph = range_offset ? u16(cmap, range_offsets + segment * 2 + range_offset + (codepoint - first) * 2) : codepoint
                        if (!range_offset || glyph) emit(codepoint, (glyph + delta) % 65536)
                    }
                }
            }
        }
    '
}

temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-icons.XXXXXX") || exit 1
trap 'rm -rf "$temporary_dir"' 0
trap 'exit 1' HUP INT TERM
if ! list_font_icons > "$temporary_dir/icons"; then
    exit 1
fi
if [ ! -s "$temporary_dir/icons" ]; then
    printf 'Icon picker: font contains no named private-use glyphs.\n' >&2
    exit 1
fi

selection=$(
    LC_ALL=C sort -t "$(printf '\t')" -k2,2f "$temporary_dir/icons" \
    | awk -F '\t' -v terminal_columns="$terminal_columns" '
        BEGIN {
            OFS = "\t"
            muted = "\033[38;2;170;170;170m"
            reset = "\033[0m"
        }
        function truncate_name(value, limit) {
            if (value == "" || length(value) <= limit) {
                return value
            }
            if (limit <= 1) {
                return substr(value, 1, limit)
            }
            return substr(value, 1, limit - 1) "…"
        }
        {
            icons[NR] = $1
            names[NR] = $2
            codepoints[NR] = $3
            if (length($2) > name_width) {
                name_width = length($2)
            }
        }
        END {
            max_name_width = terminal_columns - 18
            if (max_name_width < 16) {
                max_name_width = 16
            }
            if (name_width > max_name_width) {
                name_width = max_name_width
            }
            for (row = 1; row <= NR; row++) {
                name = truncate_name(names[row], name_width)
                codepoint = muted codepoints[row] reset
                printf "%s\t%-*s\t%s\n", icons[row], name_width + 2, name, codepoint
            }
        }
    ' \
    | tui_fzf \
        --ansi \
        --delimiter='\t' \
        --with-nth=1,2,3 \
        --nth=2,3 \
        --prompt='󰍉  Search Nerd Font icons  ' \
        --header='Enter copy · Esc quit' \
        --pointer='󰜴' \
        --marker='󰄬' \
        --border=sharp \
        --border-label=' Nerd Font Icon Picker ' \
        --info=inline-right \
        --layout=reverse \
        --no-multi \
        --no-hscroll \
        --cycle
) || exit 0

icon=$(printf '%s\n' "$selection" | awk -F '	' 'NR == 1 { print $1 }')
[ -n "$icon" ] || exit 0

if [ "$output_mode" = stdout ]; then
    printf '%s\n' "$icon"
else
    case $clipboard in
        wl-copy) printf '%s' "$icon" | wl-copy ;;
        xclip) printf '%s' "$icon" | xclip -selection clipboard ;;
        xsel) printf '%s' "$icon" | xsel --clipboard --input ;;
        pbcopy) printf '%s' "$icon" | pbcopy ;;
    esac
fi
