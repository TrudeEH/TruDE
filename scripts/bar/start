#!/bin/sh
set -eu
base=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
if [ ! -x "$base/bin/bar" ] || [ "$base/bar.c" -nt "$base/bin/bar" ] \
    || [ "$base/tray-menu.c" -nt "$base/bin/bar" ] || [ "$base/status.c" -nt "$base/bin/bar" ] || [ "$base/build.sh" -nt "$base/bin/bar" ] || [ "$base/layer-shell.xml" -nt "$base/bin/bar" ]; then
    "$base/build.sh"
fi
if [ "$#" -ne 0 ] || ! command -v jq >/dev/null 2>&1; then
    exec "$base/bin/bar" "$@"
fi

# The bar's display preference is stored under the waybar settings key.
settings=${XDG_CONFIG_HOME:-$HOME/.config}/TruDE/settings.json
primary_only=true
if [ -f "$settings" ]; then
    primary_only=$(jq -r 'if .waybar.primary_only == false then false else true end' "$settings")
fi

monitor_names() {
    monitors=$(hyprctl -j monitors) || return 1
    printf '%s\n' "$monitors" | jq -r 'map(.name) | sort | .[]'
}

children=
trap 'for pid in $children; do kill "$pid" 2>/dev/null || :; done; wait' 0
trap 'exit 0' HUP INT TERM
trap 'for pid in $children; do kill -USR1 "$pid" 2>/dev/null || :; done' USR1

outputs=$(monitor_names)
if [ -n "$outputs" ]; then
    if [ "$primary_only" = false ]; then
        for output in $outputs; do
            "$base/bin/bar" "$output" &
            children="$children $!"
        done
    else
        "$base/bin/bar" &
        children=$!
    fi
fi

# Restart with a fresh monitor list after hotplug or a bar exit.
while sleep 2; do
    if current_outputs=$(monitor_names) && [ "$current_outputs" != "$outputs" ]; then
        exit 0
    fi
    for pid in $children; do
        kill -0 "$pid" 2>/dev/null || exit 0
    done
done
