#!/bin/sh
set -u

profile=$(powerprofilesctl get 2>/dev/null || printf 'balanced')
case $profile in
    performance) icon='󰓅' ;;
    power-saver) icon='󰌪' ;;
    *) profile=balanced; icon='󰾅' ;;
esac

label=$icon
tooltip="Power profile: $profile"
devices=$(upower -e 2>/dev/null || :)
battery=$(printf '%s\n' "$devices" | awk '/\/battery_/ { print; exit }')

if [ -n "$battery" ]; then
    info=$(upower -i "$battery" 2>/dev/null || :)
    present=
    percentage=
    state=
    while IFS= read -r line; do
        value=${line#*:}
        value=${value#"${value%%[![:space:]]*}"}
        case $line in
            *present:*) [ -n "$present" ] || present=$value ;;
            *percentage:*)
                if [ -z "$percentage" ]; then
                    percentage=${value%%%*}
                    case $percentage in *[!0-9]*|'') percentage= ;; esac
                fi
                ;;
            *state:*) [ -n "$state" ] || state=$value ;;
        esac
    done <<EOF
$info
EOF
    if [ "${present:-yes}" = yes ] && [ -n "$percentage" ]; then
        line_power_online=
        if [ "$state" = fully-charged ]; then
            line_power=$(printf '%s\n' "$devices" | awk '/\/line_power_/ { print; exit }')
            if [ -n "$line_power" ]; then
                line_power_info=$(upower -i "$line_power" 2>/dev/null || :)
                while IFS= read -r line; do
                    case $line in
                        *online:*)
                            value=${line#*:}
                            line_power_online=${value#"${value%%[![:space:]]*}"}
                            break
                            ;;
                    esac
                done <<EOF
$line_power_info
EOF
            fi
        fi
        case $state in
            charging) label="$icon   $percentage%" ;;
            fully-charged)
                if [ "$line_power_online" = yes ]; then
                    label="$icon   $percentage%"
                else
                    label="$icon  $percentage%"
                fi
                ;;
            *) label="$icon  $percentage%" ;;
        esac
        tooltip="$tooltip\\nBattery: $percentage%${state:+ ($state)}"
    fi
fi

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$label" "$tooltip" "$profile"
