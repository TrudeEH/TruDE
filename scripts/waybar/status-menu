#!/bin/sh
set -u

# shellcheck source=scripts/lib/ui.sh
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/ui.sh"

selection=$(printf '%s\n' \
    'Notifications' \
    'Network settings' \
    'Bluetooth settings' \
    'USB devices' \
    | tui_fzf \
        --prompt=' Quick Settings  ' \
        --pointer='󰜴' \
        --marker='󰄬' \
        --border=sharp \
        --layout=reverse \
        --no-multi \
        --cycle) \
    || exit 0

launch_tui() {
    footclient --no-wait "$@"
}

case $selection in
    'Network settings')
        launch_tui --app-id=nmtui --title='Network Settings' \
            --override=colors.regular0=222226 --window-size-chars=82x24 \
            dotfiles-network-tui
        ;;
    'Bluetooth settings')
        launch_tui --app-id=bluetooth-tui --title='Bluetooth' \
            --override=colors.regular0=222226 --window-size-chars=82x26 \
            dotfiles-bluetooth-tui
        ;;
    'USB devices')
        launch_tui --app-id=usb-tui --title='USB Devices' \
            --override=colors.regular0=222226 --window-size-chars=92x26 \
            dotfiles-usb-tui
        ;;
    'Notifications')
        launch_tui --app-id=notification-tui --title='Notifications' \
            --override=colors.regular0=222226 --window-size-chars=94x28 \
            dotfiles-notification-tui
        ;;
esac
