#!/bin/sh
set -u

active=$(makoctl list 2>/dev/null | grep -c '^Notification ' || :)
history=$(makoctl history 2>/dev/null | grep -c '^Notification ' || :)
count=$((active + history))

if makoctl mode 2>/dev/null | grep -Fqx 'do-not-disturb'; then
    dnd=true
else
    dnd=false
fi

case $count in *[!0-9]*|'') count=0 ;; esac

if [ "$dnd" = true ]; then
    if [ "$count" -gt 0 ]; then
        state=dnd-notification
    else
        state=dnd-none
    fi
else
    if [ "$count" -gt 0 ]; then
        state=notification
    else
        state=none
    fi
fi

if [ "$count" -gt 99 ]; then
    text=99
else
    text=$count
fi

printf '{"text":"%s","alt":"%s","class":"%s"}\n' "$text" "$state" "$state"
