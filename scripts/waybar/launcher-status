#!/bin/sh
set -u

runtime_dir=${XDG_RUNTIME_DIR:-}
if [ -z "$runtime_dir" ]; then
    # shellcheck source=scripts/lib/runtime.sh
    . "$(dirname -- "$(readlink -f -- "$0")")/../lib/runtime.sh"
    runtime_dir=$(dotfiles_runtime_dir) || exit 1
fi

part=${1:-center}
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
preferences_file=$config_home/dotfiles/settings.json
umask 077
cache_file=$runtime_dir/dotfiles-waybar-launcher-status
lock_file=$runtime_dir/dotfiles-waybar-launcher-status.flock

cache_is_fresh() {
    [ -r "$cache_file" ] || return 1
    now=$(date +%s)
    modified=$(stat -c %Y "$cache_file" 2>/dev/null || printf '0')
    [ $((now - modified)) -le 1 ]
}

refresh_status() {
    exec 9> "$lock_file"
    flock -n 9 || return
    cache_is_fresh && return
    status=launcher
    if command -v pw-cli >/dev/null 2>&1; then
        if pw-cli ls Node 2>/dev/null | awk '
            /^[[:space:]]*id [0-9]+, type PipeWire:Interface:Node\// {
                if (screen && video) found = 1
                screen = 0
                video = 0
            }
            /media.class = "(Stream\/(Input|Output)\/Video|Video\/Source)"/ {
                video = 1
            }
            /media.role = "Screen"/ { screen = 1 }
            END {
                if (screen && video) found = 1
                exit !found
            }
        '; then
            status=screensharing
        fi
    fi

    temporary=$(mktemp "$runtime_dir/dotfiles-waybar-launcher-status.XXXXXX") || exit 1
    printf '%s\n' "$status" > "$temporary"
    mv "$temporary" "$cache_file"
}

if [ "$part" = center ]; then
    cache_is_fresh || refresh_status
fi
status=launcher
IFS= read -r status < "$cache_file" 2>/dev/null || status=launcher

case $part in
    left) text='' ;;
    right) text='' ;;
    *)
        if [ "$status" = screensharing ]; then
            text='󰍹'
        else
            launcher_icon=
            if [ -f "$preferences_file" ]; then
                launcher_icon=$(jq -r '.waybar.launcher_icon | strings
                    | gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;")' \
                    "$preferences_file" 2>/dev/null || :)
            fi
            text=${launcher_icon:-󰀻}
        fi
        ;;
esac

if [ "$part" = center ]; then
    text="<span font_family='JetBrainsMono Nerd Font Propo' stretch='condensed'>$text</span>"
    jq -cn --arg text "$text" --arg class "$status" '{text: $text, class: $class}'
    exit 0
fi

printf '{"text":"%s","class":"%s"}\n' "$text" "$status"
