#!/bin/sh
set -u

part=${1:-center}
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
preferences_file=$config_home/dotfiles/settings.json
runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
cache_file=$runtime_dir/dotfiles-waybar-launcher-status
lock_dir=$runtime_dir/dotfiles-waybar-launcher-status.lock

launcher_icon=
if [ -f "$preferences_file" ] && command -v jq >/dev/null 2>&1; then
    launcher_icon=$(jq -r '.waybar.launcher_icon // ""' "$preferences_file" 2>/dev/null || :)
fi

cache_is_fresh() {
    [ -r "$cache_file" ] || return 1
    now=$(date +%s)
    modified=$(stat -c %Y "$cache_file" 2>/dev/null || printf '0')
    [ $((now - modified)) -le 1 ]
}

refresh_status() {
    if ! mkdir "$lock_dir" 2>/dev/null; then
        lock_pid=
        IFS= read -r lock_pid < "$lock_dir/pid" 2>/dev/null || :
        case $lock_pid in
            ''|*[!0-9]*) ;;
            *) kill -0 "$lock_pid" 2>/dev/null && return ;;
        esac
        rm -f "$lock_dir/pid"
        rmdir "$lock_dir" 2>/dev/null || return
        mkdir "$lock_dir" 2>/dev/null || return
    fi

    printf '%s\n' "$$" > "$lock_dir/pid"
    trap 'rm -f "$lock_dir/pid"; rmdir "$lock_dir" 2>/dev/null || :' EXIT HUP INT TERM
    status=launcher
    if command -v pw-dump >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        if pw-dump 2>/dev/null | jq -e '
            any(.[];
                .type == "PipeWire:Interface:Node" and
                .info.props["media.class"] == "Stream/Input/Video" and
                .info.state == "running"
            )
        ' >/dev/null 2>&1; then
            status=screensharing
        fi
    fi

    temporary=$(mktemp "$runtime_dir/dotfiles-waybar-launcher-status.XXXXXX") || exit 1
    printf '%s\n' "$status" > "$temporary"
    mv "$temporary" "$cache_file"
}

if [ "$part" = center ]; then
    cache_is_fresh || refresh_status
fi
status=launcher
IFS= read -r status < "$cache_file" 2>/dev/null || status=launcher

case $part in
    left) text='' ;;
    right) text='' ;;
    *)
        if [ "$status" = screensharing ]; then
            text='󰍹'
        elif [ -n "$launcher_icon" ]; then
            text=$launcher_icon
        else
            text='󰀻'
        fi
        ;;
esac

if [ "$part" = center ]; then
    text="<span font_family='JetBrainsMono Nerd Font Propo' stretch='condensed'>$text</span>"
fi

printf '{"text":"%s","class":"%s"}\n' "$text" "$status"
