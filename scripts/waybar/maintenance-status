#!/bin/sh
set -u

runtime_dir=${XDG_RUNTIME_DIR:-}
if [ -z "$runtime_dir" ]; then
    # shellcheck source=scripts/lib/runtime.sh
    . "$(dirname -- "$(readlink -f -- "$0")")/../lib/runtime.sh"
    runtime_dir=$(dotfiles_runtime_dir) || exit 1
fi
umask 077
cache_file=$runtime_dir/dotfiles-waybar-maintenance.json
lock_file=$runtime_dir/dotfiles-waybar-maintenance.flock
cache_lifetime=240

cache_is_fresh() {
    [ -f "$cache_file" ] || return 1
    now=$(date +%s)
    modified=$(stat -c %Y "$cache_file" 2>/dev/null || printf '0')
    [ $((now - modified)) -lt "$cache_lifetime" ]
}

if cache_is_fresh; then
    cat "$cache_file"
    exit 0
fi

# flock is released by the kernel, so a killed refresh cannot leave a stale lock.
exec 9> "$lock_file"
if ! flock -n 9; then
    if [ -f "$cache_file" ]; then
        cat "$cache_file"
        exit 0
    fi
    exit 1
fi
if cache_is_fresh; then
    cat "$cache_file"
    exit 0
fi

apt_updates=$(apt list --upgradable 2>/dev/null \
    | awk 'NR == 1 && /^Listing/ { next } NF { count++ } END { print count + 0 }')
if command -v flatpak >/dev/null 2>&1; then
    flatpak_updates=$(flatpak remote-ls --updates --app 2>/dev/null \
        | awk 'NF { count++ } END { print count + 0 }')
else
    flatpak_updates=0
fi

trude_repo=$HOME/dotfiles
trude_updates=0
if [ -d "$trude_repo/.git" ] && command -v git >/dev/null 2>&1; then
    timeout 20s env GIT_TERMINAL_PROMPT=0 \
        GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=10' git -C "$trude_repo" \
        -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
        fetch --quiet --no-tags origin 2>/dev/null || :
    trude_upstream=$(git -C "$trude_repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || :)
    if [ -n "$trude_upstream" ]; then
        trude_updates=$(git -C "$trude_repo" rev-list --count "HEAD..$trude_upstream" 2>/dev/null || printf '0')
    fi
fi

total=$((apt_updates + flatpak_updates + trude_updates))
if [ "$trude_updates" -gt 0 ]; then
    text="  $total"
    class=trude-updates
elif [ "$total" -gt 0 ]; then
    text="  $total"
    class=updates
else
    text=''
    class=updated
fi

temporary=$(mktemp "$runtime_dir/dotfiles-waybar-maintenance.XXXXXX") || exit 1
printf '{"text":"%s","tooltip":"APT updates: %s\\nFlatpak updates: %s\\nTruDE updates: %s","class":"%s"}\n' \
    "$text" "$apt_updates" "$flatpak_updates" "$trude_updates" "$class" > "$temporary"
mv "$temporary" "$cache_file"
cat "$cache_file"
