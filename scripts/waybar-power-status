#!/bin/sh
set -u

profile=$(powerprofilesctl get 2>/dev/null || printf 'balanced')
case $profile in
    performance) icon='󰓅' ;;
    power-saver) icon='󰌪' ;;
    *) profile=balanced; icon='󰾅' ;;
esac

label=$icon
tooltip="Power profile: $profile"
battery=$(upower -e 2>/dev/null | awk '/\/battery_/ { print; exit }')

if [ -n "$battery" ]; then
    info=$(upower -i "$battery" 2>/dev/null || :)
    present=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*present:[[:space:]]*//p' | head -n 1)
    percentage=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*percentage:[[:space:]]*\([0-9][0-9]*\)%.*/\1/p' | head -n 1)
    state=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*state:[[:space:]]*//p' | head -n 1)
    if [ "${present:-yes}" = yes ] && [ -n "$percentage" ]; then
        label="$icon  $percentage%"
        tooltip="$tooltip\\nBattery: $percentage%${state:+ ($state)}"
    fi
fi

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$label" "$tooltip" "$profile"
