#!/bin/sh

interface=${1:-}

if [ -z "$interface" ]; then
    printf 'interface\tUnavailable\n'
    printf 'ip\tUnavailable\n'
    printf 'gateway\tUnavailable\n'
    printf 'dns\tUnavailable\n'
    exit 0
fi

join_lines() {
    awk 'NF { if (count++) printf ", "; printf "%s", $0 }'
}

printf 'interface\t%s\n' "$interface"

ip_address=$(ip -o -4 addr show dev "$interface" scope global 2>/dev/null | awk '{print $4}' | join_lines)
printf 'ip\t%s\n' "${ip_address:-Unavailable}"

gateway=$(ip route show default dev "$interface" 2>/dev/null | awk 'NR == 1 {print $3}')
printf 'gateway\t%s\n' "${gateway:-Unavailable}"

dns_servers=$(nmcli -g IP4.DNS device show "$interface" 2>/dev/null | join_lines)
if [ -z "$dns_servers" ]; then
    dns_servers=$(awk '/^nameserver[[:space:]]/ {print $2}' /etc/resolv.conf 2>/dev/null | join_lines)
fi
printf 'dns\t%s\n' "${dns_servers:-Unavailable}"
