#!/bin/sh
set -u

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
cache_file=$runtime_dir/dotfiles-waybar-workspaces.tsv

signal_waybar() {
    rm -f "$cache_file"
    pkill -RTMIN+7 waybar 2>/dev/null || :
}

while :; do
    signature=${HYPRLAND_INSTANCE_SIGNATURE:-}
    socket=$runtime_dir/hypr/$signature/.socket2.sock

    if [ -z "$signature" ] || [ ! -S "$socket" ]; then
        socket=
        for candidate in "$runtime_dir"/hypr/*/.socket2.sock; do
            [ -S "$candidate" ] || continue
            socket=$candidate
            break
        done
    fi

    if [ -z "$socket" ]; then
        sleep 1
        continue
    fi

    socat -u "UNIX-CONNECT:$socket" - 2>/dev/null | while IFS= read -r event; do
        case ${event%%>>*} in
            workspace|workspacev2|focusedmon|focusedmonv2|openwindow|closewindow|movewindow|movewindowv2|createworkspace|createworkspacev2|destroyworkspace|destroyworkspacev2)
                signal_waybar
                ;;
        esac
    done

    sleep 1
done
